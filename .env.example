# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - it holds live credentials.

# Gmail SMTP (use a Google Account App Password, not the account password:
# https://myaccount.google.com/apppasswords - requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Where "Hubungi Kami" and "Konsultasi Gratis" form submissions are
# forwarded to internally
NOTIFY_EMAIL=you@example.com

# Cloudflare Turnstile CAPTCHA - optional, but recommended before going
# live. Leave both blank and the forms work exactly as they do now (no
# CAPTCHA challenge, no server-side check). Fill both in and it turns on
# automatically - no other code changes needed. Get keys at
# https://dash.cloudflare.com/?to=/:account/turnstile (see README "CAPTCHA setup").
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 - optional. Leave blank and no analytics script loads
# at all. Fill in and it turns on automatically. Create a GA4 property at
# https://analytics.google.com, then Admin > Data Streams > (your web
# stream) to find the Measurement ID (format "G-XXXXXXXXXX").
PUBLIC_GA_MEASUREMENT_ID=
