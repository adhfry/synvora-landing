---
import Layout from '../layouts/Layout.astro';
import { pathFor, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  routeKey: string;
  pageTitle: string;
  lastUpdated: string;
  toc: { id: string; label: string }[];
}
const { title, description, lang, routeKey, pageTitle, lastUpdated, toc } = Astro.props;
const dict = t(lang);
const homeHref = pathFor('home', lang);
---

<Layout
  title={title}
  description={description}
  navVariant="light"
  footerVariant="default"
  lang={lang}
  routeKey={routeKey}
  bodyClass="bg-white"
>
  <section class="pt-32 pb-16 px-8 bg-[#0A1128] text-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-xs font-semibold text-gray-400 mb-6 flex items-center gap-2">
        <a href={homeHref} class="hover:text-white">{dict.legal.breadcrumbHome}</a>
        <i class="fa-solid fa-chevron-right text-[8px]"></i>
        <span class="text-white">{pageTitle}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-4">{pageTitle}</h1>
      <p class="text-sm text-gray-400">{dict.legal.lastUpdated}: {lastUpdated}</p>
    </div>
  </section>

  <section class="py-16 px-8">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-4 gap-12">
      {toc.length > 0 && (
        <nav class="hidden lg:block lg:col-span-1" aria-label="Table of contents">
          <div class="sticky top-24 space-y-1 text-xs">
            {toc.map((item) => (
              <a href={`#${item.id}`} class="block py-1.5 text-gray-500 hover:text-primary transition leading-snug">
                {item.label}
              </a>
            ))}
          </div>
        </nav>
      )}
      <div class={`lg:col-span-3 ${toc.length === 0 ? 'lg:col-span-4' : ''} text-sm text-gray-600 leading-relaxed space-y-10`}>
        <slot />
      </div>
    </div>
  </section>
</Layout>
