---
import { getNavItems } from '../lib/nav';
import { SITE } from '../lib/site';
import { pathFor, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  active?: string;
  variant?: 'landing' | 'default';
  lang?: Locale;
}
const { active = '', variant = 'default', lang = 'id' } = Astro.props;
const dict = t(lang);
const NAV_ITEMS = getNavItems(lang);

const isLanding = variant === 'landing';
const navListClass = isLanding ? 'space-y-3 text-sm text-gray-500 dark:text-gray-400' : 'space-y-3 text-xs text-gray-500 dark:text-gray-400';
const headingClass = isLanding
  ? 'font-bold text-gray-900 dark:text-white mb-6'
  : 'font-bold text-gray-900 dark:text-white mb-6 text-sm';
const contactListClass = isLanding ? 'space-y-4 text-sm text-gray-500 dark:text-gray-400' : 'space-y-4 text-xs text-gray-500 dark:text-gray-400';
const contactIconMt = isLanding ? 'mt-1' : 'mt-0.5';
const bottomBarClass = isLanding
  ? 'max-w-7xl mx-auto border-t border-gray-100 dark:border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-400'
  : 'max-w-7xl mx-auto border-t border-gray-100 dark:border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] text-gray-400';

const servicesHref = pathFor('services', lang);
const services =
  lang === 'en'
    ? [
        { label: 'Information Systems', href: servicesHref },
        { label: 'System Integration', href: servicesHref },
        { label: 'Web & Mobile Apps', href: servicesHref },
        { label: 'IT Consulting', href: servicesHref },
      ]
    : [
        { label: 'Sistem Informasi', href: servicesHref },
        { label: 'Integrasi Sistem', href: servicesHref },
        { label: 'Aplikasi Web & Mobile', href: servicesHref },
        { label: 'Konsultasi IT', href: servicesHref },
      ];

const contactInfo = [
  { icon: 'fa-solid fa-location-dot', text: SITE.address },
  { icon: 'fa-regular fa-envelope', text: SITE.email },
];
---

<footer class="bg-white dark:bg-synvora-dark pt-20 pb-10 px-8 border-t border-gray-100 dark:border-white/10 transition-colors">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
    <!-- Brand -->
    <div class="lg:col-span-2">
      <div class="mb-6">
        <img
          src="/images/logo/synvora-teknologi-indonesia-logo-bluetext.png"
          alt="SYNVORA Teknologi Indonesia"
          class="h-12 w-auto max-w-[280px] object-contain dark:hidden"
        />
        <img
          src="/images/logo/synvora-teknologi-indonesia-logo-whitetext.png"
          alt="SYNVORA Teknologi Indonesia"
          class="hidden dark:block h-12 w-auto max-w-[280px] object-contain"
        />
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-6 max-w-sm">
        {dict.footer.tagline}
      </p>
      <div class="flex gap-4 text-gray-400">
        <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition"><i class="fa-brands fa-linkedin-in" /></a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition"><i class="fa-brands fa-instagram" /></a>
        {SITE.social.showYoutube && (
          <a href="#" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition"><i class="fa-brands fa-youtube" /></a>
        )}
        <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition"><i class="fa-brands fa-github" /></a>
      </div>
    </div>

    <!-- Navigasi -->
    <div>
      <h4 class={headingClass}>{dict.footer.navHeading}</h4>
      <ul class={navListClass}>
        {NAV_ITEMS.map((item) => (
          <li>
            {item.key === active ? (
              <a href={item.href} class="text-primary font-semibold">{item.label}</a>
            ) : (
              <a href={item.href} class="hover:text-primary transition">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- Layanan -->
    <div>
      <h4 class={headingClass}>{dict.footer.servicesHeading}</h4>
      <ul class={navListClass}>
        {services.map((s) => (
          <li><a href={s.href} class="hover:text-primary transition">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Kontak -->
    <div>
      <h4 class={headingClass}>{dict.footer.contactHeading}</h4>
      <ul class={contactListClass}>
        {contactInfo.map((c) => (
          <li class="flex items-start gap-3">
            <i class={`${c.icon} text-primary ${contactIconMt}`} />
            <span class="leading-relaxed">{c.text}</span>
          </li>
        ))}
        <li class="flex items-start gap-3">
          <i class={`fa-brands fa-whatsapp text-primary ${contactIconMt}`} />
          <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition">{SITE.phoneDisplay}</a>
        </li>
        <li class="flex items-start gap-3">
          <i class={`fa-regular fa-clock text-primary ${contactIconMt}`} />
          <span set:html={dict.footer.hours.replace('\n', '<br />')} />
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class={bottomBarClass}>
    <div>&copy; 2026 {SITE.name}. {dict.footer.rights}</div>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={pathFor('privacy', lang)} class="hover:text-primary transition">{dict.footer.privacy}</a>
      <a href={pathFor('terms', lang)} class="hover:text-primary transition">{dict.footer.terms}</a>
      <a href={pathFor('cookies', lang)} class="hover:text-primary transition">{dict.footer.cookiePolicy}</a>
      <button type="button" id="cookie-settings-trigger" class="hover:text-primary transition cursor-pointer">{dict.footer.cookieSettings}</button>
    </div>
  </div>
</footer>
