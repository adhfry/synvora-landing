---
import { NAV_ITEMS } from '../lib/nav';

interface Props {
  active?: string;
  variant?: 'landing' | 'default';
}
const { active = '', variant = 'default' } = Astro.props;

const isLanding = variant === 'landing';
const navListClass = isLanding ? 'space-y-3 text-sm text-gray-500 dark:text-gray-400' : 'space-y-3 text-xs text-gray-500 dark:text-gray-400';
const headingClass = isLanding
  ? 'font-bold text-gray-900 dark:text-white mb-6'
  : 'font-bold text-gray-900 dark:text-white mb-6 text-sm';
const contactListClass = isLanding ? 'space-y-4 text-sm text-gray-500 dark:text-gray-400' : 'space-y-4 text-xs text-gray-500 dark:text-gray-400';
const contactIconMt = isLanding ? 'mt-1' : 'mt-0.5';
const bottomBarClass = isLanding
  ? 'max-w-7xl mx-auto border-t border-gray-100 dark:border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-400'
  : 'max-w-7xl mx-auto border-t border-gray-100 dark:border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center text-[10px] text-gray-400';

const services = [
  { label: 'Sistem Informasi', href: '#' },
  { label: 'Integrasi Sistem', href: '#' },
  { label: 'Aplikasi Web & Mobile', href: '#' },
  { label: 'Konsultasi IT', href: '#' },
];

const contactInfo = [
  { icon: 'fa-solid fa-location-dot', text: 'Indonesia' },
  { icon: 'fa-regular fa-envelope', text: 'hello@synvora.id' },
  { icon: 'fa-solid fa-phone', text: '+62 811 234 567' },
];
---

<footer class="bg-white dark:bg-synvora-dark pt-20 pb-10 px-8 border-t border-gray-100 dark:border-white/10 transition-colors">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
    <!-- Brand -->
    <div class="lg:col-span-2">
      <div class="mb-6">
        <img
          src="/images/logo/synvora-teknologi-indonesia-logo-bluetext.png"
          alt="SYNVORA Teknologi Indonesia"
          class="h-10 w-auto max-w-[240px] object-contain dark:hidden"
        />
        <img
          src="/images/logo/synvora-teknologi-indonesia-logo-whitetext.png"
          alt="SYNVORA Teknologi Indonesia"
          class="hidden dark:block h-10 w-auto max-w-[240px] object-contain"
        />
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-6 max-w-sm">
        Teknologi yang menyatukan, menginspirasi, dan menciptakan masa depan yang lebih baik.
      </p>
      <div class="flex gap-4 text-gray-400">
        <a href="#" class="hover:text-primary transition"><i class="fa-brands fa-linkedin-in" /></a>
        <a href="#" class="hover:text-primary transition"><i class="fa-brands fa-instagram" /></a>
        <a href="#" class="hover:text-primary transition"><i class="fa-brands fa-youtube" /></a>
        {
          isLanding ? (
            <a href="#" class="hover:text-primary transition"><i class="fa-regular fa-envelope" /></a>
          ) : (
            <a href="#" class="hover:text-primary transition"><i class="fa-brands fa-github" /></a>
          )
        }
      </div>
    </div>

    <!-- Navigasi -->
    <div>
      <h4 class={headingClass}>Navigasi</h4>
      <ul class={navListClass}>
        {NAV_ITEMS.map((item) => (
          <li>
            {item.key === active ? (
              <a href={item.href} class="text-primary font-semibold">{item.label}</a>
            ) : (
              <a href={item.href} class="hover:text-primary transition">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- Layanan -->
    <div>
      <h4 class={headingClass}>Layanan</h4>
      <ul class={navListClass}>
        {services.map((s) => (
          <li><a href={s.href} class="hover:text-primary transition">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Kontak -->
    <div>
      <h4 class={headingClass}>Kontak</h4>
      <ul class={contactListClass}>
        {contactInfo.map((c) => (
          <li class="flex items-start gap-3">
            <i class={`${c.icon} text-primary ${contactIconMt}`} />
            <span>{c.text}</span>
          </li>
        ))}
        <li class="flex items-start gap-3">
          <i class={`fa-regular fa-clock text-primary ${contactIconMt}`} />
          <span>Senin - Jumat<br />08.00 - 17.00 WIB</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class={bottomBarClass}>
    <div class="mb-4 md:mb-0">&copy; 2026 SYNVORA Teknologi Indonesia. All rights reserved.</div>
    <div class="flex gap-6">
      <a href="#" class="hover:text-primary transition">Kebijakan Privasi</a>
      <a href="#" class="hover:text-primary transition">Syarat & Ketentuan</a>
    </div>
  </div>
</footer>
