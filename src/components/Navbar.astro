---
import { NAV_ITEMS } from '../lib/nav';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  variant?: 'dark' | 'light';
  active?: string;
}
const { variant = 'light', active = '' } = Astro.props;
---

{
  variant === 'dark' ? (
    <nav class="bg-[#0A1128] text-white py-4 px-8 relative z-50">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="flex flex-col">
          <div class="flex items-center gap-2">
            <img src="/images/logo/s-synvora-logo.png" alt="" class="h-7 w-7 object-contain" />
            <span class="font-extrabold text-xl tracking-wider text-white">SYNVORA</span>
          </div>
          <span class="text-[9px] tracking-[0.2em] text-gray-400 -mt-1 ml-9">TEKNOLOGI INDONESIA</span>
        </a>

        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300">
          {NAV_ITEMS.map((item) =>
            item.key === active ? (
              <a href={item.href} class="text-white relative">
                {item.label}
                <span class="absolute bottom-[-22px] left-0 w-full h-0.5 bg-primary" />
              </a>
            ) : (
              <a href={item.href} class="hover:text-white transition">
                {item.label}
              </a>
            )
          )}
        </div>

        <div class="flex items-center gap-4">
          <ThemeToggle variant="onDark" />
          <a
            href="/hubungi-kami"
            class="bg-primary hover:bg-blue-700 text-white px-6 py-2.5 rounded-full text-sm font-semibold flex items-center gap-2 transition"
          >
            Hubungi Kami <i class="fa-solid fa-arrow-right text-xs" />
          </a>
        </div>
      </div>
    </nav>
  ) : (
    <nav class="bg-white dark:bg-synvora-dark border-b border-gray-100 dark:border-white/10 py-4 px-8 sticky top-0 z-50 shadow-sm transition-colors">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="flex flex-col cursor-pointer">
          <div class="flex items-center gap-2">
            <img src="/images/logo/s-synvora-logo.png" alt="" class="h-7 w-7 object-contain" />
            <span class="font-extrabold text-xl tracking-wider text-gray-900 dark:text-white">SYNVORA</span>
          </div>
          <span class="text-[9px] tracking-[0.2em] text-gray-400 -mt-1 ml-9">TEKNOLOGI INDONESIA</span>
        </a>

        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600 dark:text-gray-300">
          {NAV_ITEMS.map((item) =>
            item.key === active ? (
              <a href={item.href} class="text-primary font-bold border-b-2 border-primary pb-1">
                {item.label}
              </a>
            ) : (
              <a href={item.href} class="hover:text-primary transition">
                {item.label}
              </a>
            )
          )}
        </div>

        <div class="flex items-center gap-4">
          <ThemeToggle variant="onLight" />
          <a
            href="/hubungi-kami"
            class="bg-primary hover:bg-blue-700 text-white px-6 py-2.5 rounded-full text-sm font-semibold flex items-center gap-2 transition"
          >
            Hubungi Kami <i class="fa-solid fa-arrow-right text-xs" />
          </a>
        </div>
      </div>
    </nav>
  )
}
