---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
import { getRelatedPosts, type BlogPostMeta } from '../data/blogPosts';

interface Props {
  post: BlogPostMeta;
  authorRole: string;
  overlayLines: string[];
  // Featured images that are light/pale (like a light-themed app screenshot)
  // need dark overlay text instead of the default white, or it disappears.
  overlayDark?: boolean;
  quote: string;
  tags: string[];
  tocItems: string[];
}

const { post, authorRole, overlayLines, overlayDark = false, quote, tags, tocItems } = Astro.props;

const articleUrl = `${SITE.url}/blog/${post.slug}`;
const fullTitle = `${post.title} - SYNVORA Teknologi Indonesia`;
const whatsappText = `${post.title}\n\n${post.excerpt}\n\nBaca selengkapnya: ${articleUrl}`;
const tweetText = `${post.title} - ${post.excerpt}`;
const shareUrls = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`,
  x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(articleUrl)}&text=${encodeURIComponent(tweetText)}`,
  whatsapp: `https://wa.me/?text=${encodeURIComponent(whatsappText)}`,
};

const related = getRelatedPosts(post.slug, 3);

const absoluteImage = new URL(post.image, SITE.url).toString();
// Meta/OG description stays short for search-result and share-card display;
// the full excerpt (which can run longer) is what actually renders on the page.
const metaDescription = post.metaDescription ?? post.excerpt;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${articleUrl}#article`,
  headline: post.title,
  description: metaDescription,
  image: [absoluteImage],
  author: { '@type': 'Person', name: post.author },
  publisher: {
    '@id': `${SITE.url}/#organization`,
  },
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  articleSection: post.category,
  keywords: tags.join(', '),
  inLanguage: 'id-ID',
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: articleUrl },
  ],
};
---

<Layout
  title={fullTitle}
  description={metaDescription}
  navVariant="light"
  footerVariant="default"
  active="blog"
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  bodyClass="bg-[#F8FAFC] dark:bg-synvora-dark"
>
  <Fragment slot="head">
    <style is:global>
      .card-shadow {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        border: 1px solid #f3f4f6;
        background: white;
      }
      .sidebar-card {
        background: white;
        border: 1px solid #f3f4f6;
        border-radius: 16px;
        padding: 24px;
      }
      .toc-list {
        position: relative;
      }
      .toc-list::before {
        content: '';
        position: absolute;
        left: 7px;
        top: 10px;
        bottom: 10px;
        width: 2px;
        background-color: #e5e7eb;
      }
      .toc-item {
        position: relative;
        padding-left: 24px;
        margin-bottom: 16px;
      }
      .toc-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 4px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: white;
        border: 2px solid #e5e7eb;
        z-index: 1;
      }
      .toc-item.active::before {
        background-color: #0066ff;
        border-color: #0066ff;
      }
      .toc-item.active {
        color: #0066ff;
        font-weight: 600;
      }
      .share-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid #e5e7eb;
        color: #6b7280;
        transition: all 0.2s ease;
      }
      .share-btn:hover {
        border-color: #0066ff;
        color: #0066ff;
        background-color: #f0f7ff;
      }
      .share-icon-img {
        width: 16px;
        height: 16px;
        object-fit: contain;
        display: block;
      }
      .tag-btn {
        background-color: #f0f7ff;
        color: #0066ff;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 600;
        transition: all 0.2s ease;
      }
      .tag-btn:hover {
        background-color: #0066ff;
        color: white;
      }
      .dark .card-shadow {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.08);
      }
      .dark .sidebar-card {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.08);
      }
      .dark .toc-list::before {
        background-color: rgba(255, 255, 255, 0.12);
      }
      .dark .toc-item::before {
        background-color: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.2);
      }
      .star-btn {
        color: #d1d5db;
        transition: color 0.15s ease, transform 0.15s ease;
        cursor: pointer;
        background: none;
        border: none;
        padding: 2px;
        opacity: 0;
        transform: translateY(6px) scale(0.6);
        position: relative;
      }
      .star-btn.revealed {
        animation: starReveal 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      }
      .star-btn.active,
      .star-btn.preview {
        color: #f59e0b;
      }
      .star-btn.pop {
        animation: starPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      @keyframes starReveal {
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
      @keyframes starPop {
        0% {
          transform: scale(1) rotate(0deg);
        }
        35% {
          transform: scale(1.45) rotate(-12deg);
        }
        65% {
          transform: scale(0.9) rotate(8deg);
        }
        100% {
          transform: scale(1) rotate(0deg);
        }
      }
      .sprinkle-dot {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        pointer-events: none;
        animation: sprinkleFly 0.8s ease-out forwards;
        z-index: 20;
      }
      @keyframes sprinkleFly {
        0% {
          transform: translate(-50%, -50%) scale(1);
          opacity: 1;
        }
        100% {
          transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0);
          opacity: 0;
        }
      }
      .comment-cta-card {
        background: linear-gradient(120deg, #0066ff 0%, #4f46e5 50%, #0066ff 100%);
        background-size: 200% 200%;
        animation: ctaShimmer 6s ease infinite;
      }
      @keyframes ctaShimmer {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }
      .comment-cta-glow {
        position: absolute;
        top: -30%;
        right: -10%;
        width: 140px;
        height: 140px;
        background: rgba(255, 255, 255, 0.25);
        border-radius: 50%;
        filter: blur(30px);
        animation: ctaFloat 4s ease-in-out infinite;
      }
      @keyframes ctaFloat {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        50% {
          transform: translate(-10px, 12px) scale(1.15);
        }
      }
      .comment-cta-icon {
        animation: ctaBounce 2.2s ease-in-out infinite;
      }
      @keyframes ctaBounce {
        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }
        25% {
          transform: translateY(-3px) rotate(-6deg);
        }
        50% {
          transform: translateY(0) rotate(0deg);
        }
        75% {
          transform: translateY(-2px) rotate(6deg);
        }
      }
      .comment-input {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 13px;
        background: white;
      }
      .comment-input:focus {
        outline: none;
        border-color: #0066ff;
      }
      .dark .comment-input {
        background: transparent;
        border-color: rgba(255, 255, 255, 0.12);
        color: #e5e7eb;
      }
      .comment-avatar {
        width: 36px;
        height: 36px;
        border-radius: 9999px;
        background: #f0f7ff;
        color: #0066ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
      }
      .dark .comment-avatar {
        background: rgba(0, 102, 255, 0.15);
      }
      .dark .share-btn {
        border-color: rgba(255, 255, 255, 0.15);
        color: #9ca3af;
      }
    </style>
    <meta property="article:published_time" content={post.publishedAt} />
    <meta property="article:author" content={post.author} />
    <meta property="article:section" content={post.category} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="max-w-7xl mx-auto px-8 py-10">

    <!-- Breadcrumb -->
    <div class="text-xs font-semibold text-gray-400 mb-6 flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-primary transition">Beranda</a>
      <i class="fa-solid fa-chevron-right text-[8px]"></i>
      <a href="/blog" class="hover:text-primary transition">Blog</a>
      <i class="fa-solid fa-chevron-right text-[8px]"></i>
      <span class="text-gray-500">{post.category}</span>
      <i class="fa-solid fa-chevron-right text-[8px]"></i>
      <span class="text-gray-800 dark:text-gray-200">{post.title}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- LEFT COLUMN: ARTICLE CONTENT -->
      <div class="lg:col-span-2">

        <!-- Featured Image -->
        <div class="relative rounded-2xl overflow-hidden mb-6 shadow-md">
          <img src={post.image} alt={post.title} class="w-full h-[400px] object-cover">
          <div class="absolute top-6 left-6 bg-white/90 backdrop-blur px-4 py-1.5 rounded-full text-[11px] font-bold text-gray-800 shadow-sm">{post.category}</div>
          <div class="absolute top-6 right-6 text-right">
            <div class:list={['text-2xl font-extrabold leading-tight', overlayDark ? 'text-gray-900' : 'text-white']}>
              {overlayLines.map((line, i) => <>{line}{i < overlayLines.length - 1 && <br />}</>)}
            </div>
            <div class="w-12 h-1 bg-primary ml-auto mt-2"></div>
          </div>
        </div>

        <!-- Article Header -->
        <div class="mb-8">
          <!-- Author & Meta -->
          <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-3">
              {post.authorImage ? (
                <img src={post.authorImage} alt={post.author} class="w-10 h-10 rounded-full object-cover">
              ) : (
                <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold">{post.author.charAt(0)}</div>
              )}
              <div>
                <div class="text-xs font-bold text-gray-900 dark:text-white">{post.author}</div>
                <div class="text-[10px] text-gray-500 dark:text-gray-400">{authorRole}</div>
              </div>
            </div>
            <div class="flex items-center gap-4 text-[10px] text-gray-500 dark:text-gray-400">
              <span class="flex items-center gap-1"><i class="fa-regular fa-clock"></i> {post.publishedDisplay}</span>
              <span class="flex items-center gap-1"><i class="fa-regular fa-clock"></i> {post.readTime}</span>
              <span class="flex items-center gap-1"><i class="fa-regular fa-eye"></i> <span id="view-count-display">-</span> dilihat</span>
            </div>
            <div class="flex gap-2">
              <a href={shareUrls.linkedin} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke LinkedIn"><i class="fa-brands fa-linkedin-in text-sm"></i></a>
              <a href={shareUrls.facebook} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke Facebook"><img src="/icons/facebook-logo.png" alt="Facebook" class="share-icon-img"></a>
              <a href={shareUrls.x} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke X"><img src="/icons/x-twitter-logo.webp" alt="X" class="share-icon-img"></a>
              <a href={shareUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke WhatsApp"><img src="/icons/whatsapp-logo.png" alt="WhatsApp" class="share-icon-img"></a>
              <button class="share-btn copy-link-btn" type="button" aria-label="Bagikan halaman ini"><i class="fa-solid fa-share-nodes text-sm"></i></button>
            </div>
          </div>

          <!-- Title -->
          <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white leading-tight mb-4">{post.title}</h1>

          <!-- Excerpt -->
          <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed">{post.excerpt}</p>
        </div>

        <!-- Quote Block -->
        <div class="border-l-4 border-primary bg-[#F8FAFC] dark:bg-white/5 p-6 rounded-r-xl mb-10 relative">
          <i class="fa-solid fa-quote-left text-4xl text-blue-100 dark:text-white/10 absolute top-4 left-4"></i>
          <p class="text-sm text-gray-700 dark:text-gray-200 italic relative z-10 pl-6 leading-relaxed">{quote}</p>
        </div>

        <!-- Article body sections (per-article content) -->
        <slot />

        <!-- Tags & Share -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 dark:border-white/10 pt-6 mb-12">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-gray-900 dark:text-white mr-2">Tag:</span>
            {tags.map((tag) => <a href="/blog" class="tag-btn">{tag}</a>)}
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-gray-900 dark:text-white">Bagikan:</span>
            <a href={shareUrls.linkedin} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke LinkedIn"><i class="fa-brands fa-linkedin-in text-sm"></i></a>
            <a href={shareUrls.facebook} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke Facebook"><img src="/icons/facebook-logo.png" alt="Facebook" class="share-icon-img"></a>
            <a href={shareUrls.x} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke X"><img src="/icons/x-twitter-logo.webp" alt="X" class="share-icon-img"></a>
            <a href={shareUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Bagikan ke WhatsApp"><img src="/icons/whatsapp-logo.png" alt="WhatsApp" class="share-icon-img"></a>
            <button class="share-btn copy-link-btn" type="button" aria-label="Bagikan halaman ini"><i class="fa-solid fa-share-nodes text-sm"></i></button>
          </div>
        </div>

        <!-- Komentar -->
        <div class="mb-12" id="comments-section" data-slug={post.slug}>
          <h3 class="text-xl font-extrabold text-gray-900 dark:text-white mb-6">
            Komentar <span id="comment-count" class="text-primary"></span>
          </h3>

          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
            <!-- Daftar komentar -->
            <div class="lg:col-span-3">
              <div id="comments-list" class="space-y-5">
                <p class="text-xs text-gray-400">Memuat komentar...</p>
              </div>
            </div>

            <!-- Rating + form, di sebelah kanan pada layar besar -->
            <div class="lg:col-span-2">
              <div class="lg:sticky lg:top-24 space-y-4">

                <!-- Kartu ajakan -->
                <div class="comment-cta-card relative overflow-hidden rounded-2xl p-5 text-white shadow-lg">
                  <div class="comment-cta-glow"></div>
                  <div class="relative z-10 flex items-center gap-3">
                    <div class="comment-cta-icon w-11 h-11 rounded-full bg-white/15 flex items-center justify-center text-lg shrink-0">
                      <i class="fa-solid fa-comment-dots"></i>
                    </div>
                    <div>
                      <div class="font-bold text-sm leading-tight">Apa pendapatmu?</div>
                      <div class="text-[11px] text-white/80 leading-relaxed mt-0.5">Yuk tulis komentar, pendapatmu bisa bantu pembaca lain juga!</div>
                    </div>
                  </div>
                </div>

                <!-- Rating pembaca -->
                <div class="sidebar-card flex items-center justify-between">
                  <span class="text-xs font-bold text-gray-900 dark:text-white">Rating Pembaca</span>
                  <div id="rating-summary" class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-300"></div>
                </div>

                <!-- Form -->
                <div class="sidebar-card">
                  <h4 class="font-bold text-gray-900 dark:text-white text-base mb-4">Tulis Komentar</h4>
                  <form id="comment-form" novalidate>
                    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

                    <label for="comment-name" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Nama yang ditampilkan</label>
                    <input type="text" id="comment-name" maxlength="60" placeholder="Misalnya: Danur Wenda" class="comment-input mb-4" required />

                    <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Beri rating (opsional)</label>
                    <div id="star-input" class="relative flex gap-1 text-2xl mb-4" data-value="0">
                      <button type="button" class="star-btn" data-star="1" aria-label="1 bintang"><i class="fa-solid fa-star"></i></button>
                      <button type="button" class="star-btn" data-star="2" aria-label="2 bintang"><i class="fa-solid fa-star"></i></button>
                      <button type="button" class="star-btn" data-star="3" aria-label="3 bintang"><i class="fa-solid fa-star"></i></button>
                      <button type="button" class="star-btn" data-star="4" aria-label="4 bintang"><i class="fa-solid fa-star"></i></button>
                      <button type="button" class="star-btn" data-star="5" aria-label="5 bintang"><i class="fa-solid fa-star"></i></button>
                    </div>

                    <label for="comment-text" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Komentar</label>
                    <textarea id="comment-text" maxlength="1000" rows="4" placeholder="Tulis pendapatmu..." class="comment-input mb-4 resize-none" required></textarea>

                    <label class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mb-4 cursor-pointer">
                      <input type="checkbox" id="remember-name" class="rounded" /> Ingat nama saya di perangkat ini
                    </label>

                    <p id="comment-form-error" class="text-xs text-red-500 mb-3 hidden"></p>

                    <button type="submit" class="bg-primary hover:bg-blue-700 text-white px-6 py-2.5 rounded-full text-xs font-semibold transition inline-flex items-center gap-2 w-full justify-center">
                      <span id="comment-submit-label">Kirim Komentar</span>
                    </button>
                  </form>
                </div>

              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: SIDEBAR -->
      <div class="lg:col-span-1 space-y-8">

        <!-- Daftar Isi -->
        <div class="sidebar-card">
          <h3 class="font-bold text-gray-900 dark:text-white text-base mb-6">Daftar Isi</h3>
          <div class="toc-list">
            {tocItems.map((item, i) => (
              <div class:list={['toc-item text-sm', i === 0 ? 'active' : 'text-gray-600 dark:text-gray-300']}>{item}</div>
            ))}
          </div>
        </div>

        <!-- Promo Box -->
        <div class="relative rounded-2xl overflow-hidden shadow-lg bg-[#0A1128] p-6 text-white">
          <div class="absolute inset-0 opacity-20 bg-[url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=600')] bg-cover bg-center"></div>
          <div class="relative z-10">
            <div class="text-[10px] font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span> KONSULTASI GRATIS
            </div>
            <h3 class="font-bold text-lg leading-tight mb-3">Diskusikan Kebutuhan Teknologi Anda</h3>
            <p class="text-[11px] text-gray-300 mb-6">Temukan solusi terbaik bersama tim ahli SYNVORA.</p>
            <a href="/konsultasi-gratis" class="bg-primary hover:bg-blue-700 text-white px-5 py-2.5 rounded-full text-xs font-semibold inline-flex items-center gap-2 transition">
              Konsultasi Sekarang <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>

        <!-- Artikel Terkait -->
        <div class="sidebar-card">
          <h3 class="font-bold text-gray-900 dark:text-white text-base mb-6">Artikel Terkait</h3>
          <div class="space-y-5">
            {related.map((r) => (
              <a href={`/blog/${r.slug}`} class="flex gap-4 cursor-pointer group">
                <div class="w-20 h-20 rounded-xl overflow-hidden shrink-0">
                  <img src={r.image} alt={r.title} class="w-full h-full object-cover group-hover:scale-110 transition duration-300">
                </div>
                <div>
                  <h4 class="text-xs font-bold text-gray-900 dark:text-white leading-tight mb-1 group-hover:text-primary transition">{r.title}</h4>
                  <div class="text-[9px] text-gray-400 flex items-center gap-2">
                    <span>{r.publishedDisplay}</span>
                    <span class="flex items-center gap-1"><i class="fa-regular fa-clock"></i> {r.readTime}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Newsletter -->
        <div class="sidebar-card">
          <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-lg mb-4">
            <i class="fa-regular fa-envelope"></i>
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white text-base mb-2">Newsletter</h3>
          <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-3">Dapatkan Artikel Terbaru</h4>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mb-6 leading-relaxed">Berlangganan newsletter kami untuk mendapatkan insight teknologi, inovasi, dan berita terbaru langsung ke email Anda.</p>
          <div class="relative mb-3">
            <input type="email" placeholder="Masukkan email Anda" class="w-full pl-4 pr-4 py-3 border border-gray-200 dark:border-white/10 dark:bg-transparent rounded-xl text-xs focus:outline-none focus:border-primary">
          </div>
          <button class="w-full bg-primary hover:bg-blue-700 text-white py-3 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition">
            Berlangganan <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </button>
          <div class="flex items-center gap-2 mt-4 text-[9px] text-gray-400">
            <i class="fa-solid fa-lock"></i> Kami menghargai privasi Anda. Tidak ada spam, hanya konten berkualitas.
          </div>
        </div>

        <!-- Quote Box -->
        <div class="bg-gray-50 dark:bg-white/5 p-6 rounded-2xl border border-gray-100 dark:border-white/10 relative">
          <i class="fa-solid fa-quote-left text-3xl text-blue-100 dark:text-white/10 absolute top-4 left-4"></i>
          <p class="text-xs text-gray-600 dark:text-gray-300 italic relative z-10 mb-4 pl-4 pt-4">"Teknologi yang tepat bukan hanya menyelesaikan masalah saat ini, tetapi juga membuka peluang untuk masa depan yang lebih baik."</p>
          <div class="w-8 h-0.5 bg-primary mb-2 ml-4"></div>
          <div class="text-[9px] font-bold tracking-widest text-primary ml-4">SYNVORA TEKNOLOGI INDONESIA</div>
        </div>

      </div>
    </div>
  </main>

  <script is:inline define:vars={{ slug: post.slug }}>
    (function () {
      const display = document.getElementById('view-count-display');
      if (!display) return;
      function formatCount(n) {
        if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
        return String(n);
      }
      fetch('/api/blog-view', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      })
        .then((res) => (res.ok ? res.json() : Promise.reject()))
        .then((data) => {
          display.textContent = formatCount(data.count);
        })
        .catch(() => {
          display.textContent = '0';
        });
    })();
  </script>

  <script is:inline define:vars={{ postTitle: post.title, postExcerpt: post.excerpt, articleUrl }}>
    document.querySelectorAll('.copy-link-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const shareData = {
          title: postTitle,
          text: postExcerpt,
          url: articleUrl,
        };
        if (navigator.share) {
          try {
            await navigator.share(shareData);
            return;
          } catch (err) {
            if (err && err.name === 'AbortError') return;
          }
        }
        try {
          const clipboardText = `${postTitle}\n\n${postExcerpt}\n\nBaca Selengkapnya di ${articleUrl}`;
          await navigator.clipboard.writeText(clipboardText);
          const icon = btn.querySelector('i');
          if (icon) {
            const original = icon.className;
            icon.className = 'fa-solid fa-check text-sm';
            setTimeout(() => {
              icon.className = original;
            }, 1500);
          }
        } catch (err) {
          console.error('Gagal menyalin tautan:', err);
        }
      });
    });
  </script>

  <script is:inline define:vars={{ slug: post.slug }}>
    (function () {
      const section = document.getElementById('comments-section');
      if (!section) return;

      const listEl = document.getElementById('comments-list');
      const countEl = document.getElementById('comment-count');
      const ratingSummaryEl = document.getElementById('rating-summary');
      const form = document.getElementById('comment-form');
      const nameInput = document.getElementById('comment-name');
      const textInput = document.getElementById('comment-text');
      const websiteInput = form.querySelector('input[name="website"]');
      const rememberCheckbox = document.getElementById('remember-name');
      const errorEl = document.getElementById('comment-form-error');
      const starInput = document.getElementById('star-input');
      const starButtons = Array.from(starInput.querySelectorAll('.star-btn'));
      const submitLabel = document.getElementById('comment-submit-label');
      const NAME_KEY = 'synvora_comment_name';

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str == null ? '' : String(str);
        return div.innerHTML;
      }

      function initials(name) {
        const parts = String(name || '?').trim().split(/\s+/).filter(Boolean);
        if (parts.length === 0) return '?';
        if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
        return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
      }

      function formatDate(iso) {
        try {
          return new Date(iso).toLocaleString('id-ID', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
        } catch {
          return '';
        }
      }

      function starsHtml(rating) {
        if (!rating) return '';
        let out = '<span class="text-amber-500 text-[11px]">';
        for (let i = 1; i <= 5; i++) {
          out += `<i class="fa-solid fa-star${i > rating ? ' text-gray-200 dark:text-white/10' : ''}"></i>`;
        }
        return out + '</span>';
      }

      // Restore remembered name.
      try {
        const saved = localStorage.getItem(NAME_KEY);
        if (saved) {
          nameInput.value = saved;
          rememberCheckbox.checked = true;
        }
      } catch {}

      // Star rating input: staggered reveal on scroll-into-view, a little
      // "pop" bounce per click, a hover preview, and a confetti-ish sprinkle
      // burst when someone lands on a full 5-star rating.
      let selectedRating = 0;

      function renderStars(previewValue) {
        const upTo = previewValue != null ? previewValue : selectedRating;
        starButtons.forEach((btn) => {
          const val = Number(btn.dataset.star);
          btn.classList.toggle('active', previewValue == null && val <= selectedRating);
          btn.classList.toggle('preview', previewValue != null && val <= upTo);
        });
      }

      function popStar(btn) {
        btn.classList.remove('pop');
        // Force reflow so the animation restarts even on repeated clicks.
        void btn.offsetWidth;
        btn.classList.add('pop');
      }

      const SPRINKLE_COLORS = ['#f59e0b', '#0066ff', '#22c55e', '#ec4899', '#a855f7'];
      function sprinkleBurst() {
        const rect = starInput.getBoundingClientRect();
        const count = 16;
        for (let i = 0; i < count; i++) {
          const dot = document.createElement('span');
          dot.className = 'sprinkle-dot';
          const angle = Math.random() * Math.PI * 2;
          const distance = 30 + Math.random() * 40;
          dot.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
          dot.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
          dot.style.background = SPRINKLE_COLORS[i % SPRINKLE_COLORS.length];
          dot.style.left = `${(rect.width / 2)}px`;
          starInput.appendChild(dot);
          dot.addEventListener('animationend', () => dot.remove());
        }
      }

      starButtons.forEach((btn, i) => {
        btn.addEventListener('click', () => {
          const val = Number(btn.dataset.star);
          selectedRating = selectedRating === val ? 0 : val;
          renderStars();
          popStar(btn);
          if (selectedRating === 5) sprinkleBurst();
        });
        btn.addEventListener('mouseenter', () => renderStars(Number(btn.dataset.star)));
        btn.addEventListener('mouseleave', () => renderStars());
      });

      // Reveal the stars with a little stagger once the comment form
      // actually scrolls into view, instead of all popping in at once.
      const starObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            starButtons.forEach((btn, i) => {
              setTimeout(() => btn.classList.add('revealed'), i * 90);
            });
            starObserver.disconnect();
          });
        },
        { threshold: 0.4 }
      );
      starObserver.observe(starInput);

      function replyFormHtml(commentId) {
        return `
          <form class="reply-form mt-3 space-y-2" data-parent-id="${commentId}">
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="text" class="comment-input reply-name" placeholder="Nama kamu" maxlength="60" required />
            <textarea class="comment-input reply-text" rows="2" placeholder="Tulis balasan..." maxlength="1000" required></textarea>
            <div class="flex items-center gap-2">
              <button type="submit" class="bg-primary hover:bg-blue-700 text-white px-4 py-1.5 rounded-full text-[11px] font-semibold transition">Kirim Balasan</button>
              <button type="button" class="reply-cancel-btn text-[11px] text-gray-400 hover:text-gray-600">Batal</button>
            </div>
            <p class="reply-error text-[11px] text-red-500 hidden"></p>
          </form>
        `;
      }

      function replyHtml(reply) {
        return `
          <div class="flex items-start gap-2.5">
            <div class="comment-avatar" style="width:28px;height:28px;font-size:10px;">${escapeHtml(initials(reply.name))}</div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-xs text-gray-900 dark:text-white">${escapeHtml(reply.name)}</span>
                <span class="text-[10px] text-gray-400">${formatDate(reply.createdAt)}</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-300 mt-0.5">${escapeHtml(reply.text)}</p>
            </div>
          </div>
        `;
      }

      function commentHtml(comment) {
        const replies = (comment.replies || []).map(replyHtml).join('');
        return `
          <div class="border-b border-gray-100 dark:border-white/10 pb-5" data-comment-id="${escapeHtml(comment.id)}">
            <div class="flex items-start gap-3">
              <div class="comment-avatar">${escapeHtml(initials(comment.name))}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-sm text-gray-900 dark:text-white">${escapeHtml(comment.name)}</span>
                  ${starsHtml(comment.rating)}
                  <span class="text-[10px] text-gray-400">${formatDate(comment.createdAt)}</span>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">${escapeHtml(comment.text)}</p>
                <button type="button" class="reply-toggle-btn text-[11px] font-semibold text-primary mt-1.5">Balas</button>
                <div class="reply-form-slot"></div>
                ${replies ? `<div class="replies mt-3 space-y-3 pl-4 border-l-2 border-gray-100 dark:border-white/10">${replies}</div>` : ''}
              </div>
            </div>
          </div>
        `;
      }

      async function loadComments() {
        try {
          const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
          if (!res.ok) throw new Error('failed');
          const data = await res.json();
          const comments = data.comments || [];
          const summary = data.summary || { average: 0, count: 0 };

          countEl.textContent = comments.length ? `(${comments.length})` : '';
          ratingSummaryEl.innerHTML = summary.count
            ? `<i class="fa-solid fa-star text-amber-500"></i> <strong class="text-gray-900 dark:text-white">${summary.average}</strong> dari ${summary.count} ulasan`
            : '';

          listEl.innerHTML = comments.length
            ? comments.map(commentHtml).join('')
            : '<p class="text-sm text-gray-400">Belum ada komentar. Jadilah yang pertama berkomentar!</p>';
        } catch {
          listEl.innerHTML = '<p class="text-sm text-red-400">Gagal memuat komentar. Coba muat ulang halaman.</p>';
        }
      }

      // Main comment form submit.
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');

        const name = nameInput.value.trim();
        const text = textInput.value.trim();
        if (!name || !text) {
          errorEl.textContent = 'Nama dan komentar wajib diisi.';
          errorEl.classList.remove('hidden');
          return;
        }

        submitLabel.textContent = 'Mengirim...';
        try {
          const res = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              slug,
              name,
              text,
              rating: selectedRating || undefined,
              website: websiteInput.value,
            }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            throw new Error(data.error || 'Gagal mengirim komentar.');
          }

          try {
            if (rememberCheckbox.checked) {
              localStorage.setItem(NAME_KEY, name);
            } else {
              localStorage.removeItem(NAME_KEY);
            }
          } catch {}

          textInput.value = '';
          selectedRating = 0;
          renderStars();
          await loadComments();
        } catch (err) {
          errorEl.textContent = err.message || 'Terjadi kesalahan. Coba lagi nanti.';
          errorEl.classList.remove('hidden');
        } finally {
          submitLabel.textContent = 'Kirim Komentar';
        }
      });

      // Event delegation for "Balas" buttons, reply forms, and cancel buttons
      // rendered dynamically inside the comments list.
      listEl.addEventListener('click', (e) => {
        const toggleBtn = e.target.closest('.reply-toggle-btn');
        if (toggleBtn) {
          const slot = toggleBtn.parentElement.querySelector('.reply-form-slot');
          const commentEl = toggleBtn.closest('[data-comment-id]');
          const commentId = commentEl.dataset.commentId;
          if (slot.innerHTML) {
            slot.innerHTML = '';
          } else {
            slot.innerHTML = replyFormHtml(commentId);
          }
          return;
        }
        const cancelBtn = e.target.closest('.reply-cancel-btn');
        if (cancelBtn) {
          cancelBtn.closest('.reply-form-slot').innerHTML = '';
        }
      });

      listEl.addEventListener('submit', async (e) => {
        const replyForm = e.target.closest('.reply-form');
        if (!replyForm) return;
        e.preventDefault();

        const parentId = replyForm.dataset.parentId;
        const nameEl = replyForm.querySelector('.reply-name');
        const textEl = replyForm.querySelector('.reply-text');
        const websiteEl = replyForm.querySelector('input[name="website"]');
        const errEl = replyForm.querySelector('.reply-error');
        const submitBtn = replyForm.querySelector('button[type="submit"]');

        const name = nameEl.value.trim();
        const text = textEl.value.trim();
        errEl.classList.add('hidden');
        if (!name || !text) {
          errEl.textContent = 'Nama dan balasan wajib diisi.';
          errEl.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        try {
          const res = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, name, text, parentId, website: websiteEl.value }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Gagal mengirim balasan.');
          await loadComments();
        } catch (err) {
          errEl.textContent = err.message || 'Terjadi kesalahan. Coba lagi nanti.';
          errEl.classList.remove('hidden');
          submitBtn.disabled = false;
        }
      });

      loadComments();
    })();
  </script>
</Layout>
