---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale).cookie;
---

<!-- ================= COOKIE BANNER ================= -->
<div
  id="cookie-banner"
  class="hidden fixed inset-x-0 bottom-0 z-[200] p-4 sm:p-6"
  role="region"
  aria-label={dict.bannerTitle}
>
  <div class="max-w-3xl mx-auto bg-white dark:bg-[#0f1a3d] border border-gray-200 dark:border-white/10 rounded-2xl shadow-2xl p-6 sm:p-7">
    <h2 class="font-bold text-gray-900 dark:text-white text-sm mb-2">{dict.bannerTitle}</h2>
    <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed mb-5">{dict.bannerBody}</p>
    <div class="flex flex-wrap gap-3">
      <button type="button" id="cookie-accept-all" class="bg-primary hover:bg-blue-700 text-white px-5 py-2.5 rounded-full text-xs font-semibold transition">
        {dict.acceptAll}
      </button>
      <button type="button" id="cookie-manage" class="border border-gray-300 dark:border-white/20 text-gray-700 dark:text-gray-200 hover:border-primary hover:text-primary px-5 py-2.5 rounded-full text-xs font-semibold transition">
        {dict.managePreferences}
      </button>
      <button type="button" id="cookie-reject-nonessential" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 px-5 py-2.5 rounded-full text-xs font-semibold transition">
        {dict.rejectNonEssential}
      </button>
    </div>
  </div>
</div>

<!-- ================= COOKIE PREFERENCES MODAL ================= -->
<div
  id="cookie-modal"
  class="hidden fixed inset-0 bg-black/60 z-[210] items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-modal-title"
>
  <div class="bg-white dark:bg-[#0f1a3d] rounded-2xl max-w-lg w-full max-h-[85vh] overflow-y-auto shadow-2xl">
    <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/10 sticky top-0 bg-white dark:bg-[#0f1a3d]">
      <h2 id="cookie-modal-title" class="font-extrabold text-gray-900 dark:text-white text-base">{dict.modalTitle}</h2>
      <button type="button" id="cookie-modal-close" aria-label={dict.close} class="w-9 h-9 rounded-full bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-gray-200 dark:hover:bg-white/20 transition">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="p-6 space-y-5">
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{dict.modalIntro}</p>

      <div class="border border-gray-100 dark:border-white/10 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-sm text-gray-900 dark:text-white">{dict.categories.necessary.title}</span>
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">{dict.categories.necessary.badge}</span>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{dict.categories.necessary.desc}</p>
      </div>

      <div class="border border-gray-100 dark:border-white/10 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-sm text-gray-900 dark:text-white">{dict.categories.preferences.title}</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-preferences" class="sr-only peer" />
            <div class="w-9 h-5 bg-gray-200 dark:bg-white/20 rounded-full peer-checked:bg-primary transition-colors"></div>
            <div class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
          </label>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{dict.categories.preferences.desc}</p>
      </div>

      <div class="border border-gray-100 dark:border-white/10 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-sm text-gray-900 dark:text-white">{dict.categories.analytics.title}</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-analytics" class="sr-only peer" />
            <div class="w-9 h-5 bg-gray-200 dark:bg-white/20 rounded-full peer-checked:bg-primary transition-colors"></div>
            <div class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
          </label>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{dict.categories.analytics.desc}</p>
      </div>

      <div class="border border-gray-100 dark:border-white/10 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-sm text-gray-900 dark:text-white">{dict.categories.marketing.title}</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-marketing" class="sr-only peer" />
            <div class="w-9 h-5 bg-gray-200 dark:bg-white/20 rounded-full peer-checked:bg-primary transition-colors"></div>
            <div class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
          </label>
        </div>
        <span class="inline-block text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-1.5">{dict.categories.marketing.badge}</span>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{dict.categories.marketing.desc}</p>
      </div>
    </div>
    <div class="p-6 pt-0 flex flex-wrap gap-3 sticky bottom-0 bg-white dark:bg-[#0f1a3d]">
      <button type="button" id="cookie-modal-save" class="bg-primary hover:bg-blue-700 text-white px-6 py-2.5 rounded-full text-xs font-semibold transition">
        {dict.save}
      </button>
      <button type="button" id="cookie-accept-all-modal" class="border border-gray-300 dark:border-white/20 text-gray-700 dark:text-gray-200 hover:border-primary hover:text-primary px-6 py-2.5 rounded-full text-xs font-semibold transition">
        {dict.acceptAll}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var CONSENT_COOKIE = 'synvora_cookie_consent';
    var CONSENT_VERSION = '1.0';

    function getCookie(name) {
      var escaped = name.replace(/([.$?*|{}()[\]\\/+^])/g, '\\$1');
      var match = document.cookie.match(new RegExp('(?:^|; )' + escaped + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : null;
    }
    function setCookie(name, value, maxAgeSeconds) {
      var secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = name + '=' + encodeURIComponent(value) + '; Path=/; Max-Age=' + maxAgeSeconds + '; SameSite=Lax' + secure;
    }
    function deleteCookie(name) {
      document.cookie = name + '=; Path=/; Max-Age=0; SameSite=Lax';
    }
    function readConsent() {
      var raw = getCookie(CONSENT_COOKIE);
      if (!raw) return null;
      try {
        var parsed = JSON.parse(raw);
        return parsed && parsed.version ? parsed : null;
      } catch (e) {
        return null;
      }
    }

    function loadAnalytics() {
      if (!window.__SYNVORA_GA_ID__ || window.__synvoraAnalyticsLoaded) return;
      window.__synvoraAnalyticsLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.__SYNVORA_GA_ID__;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', window.__SYNVORA_GA_ID__);
    }

    function applyConsent(consent) {
      if (consent.analytics) loadAnalytics();
      // marketing: nothing to load today - no marketing scripts exist on this site.
    }

    function writeConsent(partial) {
      var consent = {
        version: CONSENT_VERSION,
        timestamp: new Date().toISOString(),
        necessary: true,
        preferences: !!partial.preferences,
        analytics: !!partial.analytics,
        marketing: !!partial.marketing,
      };
      setCookie(CONSENT_COOKIE, JSON.stringify(consent), 60 * 60 * 24 * 180);
      if (!consent.preferences) deleteCookie('synvora_locale');
      applyConsent(consent);
      return consent;
    }

    window.synvoraGetConsent = function () {
      return readConsent() || { version: CONSENT_VERSION, necessary: true, preferences: false, analytics: false, marketing: false };
    };

    window.synvoraSetLocale = function (locale) {
      var consent = readConsent();
      if (consent && consent.preferences) {
        setCookie('synvora_locale', locale, 60 * 60 * 24 * 365);
      }
    };

    var existing = readConsent();
    var banner = document.getElementById('cookie-banner');
    var modal = document.getElementById('cookie-modal');
    var prefToggle = document.getElementById('toggle-preferences');
    var analyticsToggle = document.getElementById('toggle-analytics');
    var marketingToggle = document.getElementById('toggle-marketing');
    var modalCloseBtn = document.getElementById('cookie-modal-close');

    function showBanner() {
      banner.classList.remove('hidden');
    }
    function hideBanner() {
      banner.classList.add('hidden');
    }
    function syncToggles(consent) {
      prefToggle.checked = !!consent.preferences;
      analyticsToggle.checked = !!consent.analytics;
      marketingToggle.checked = !!consent.marketing;
    }
    function openModal() {
      syncToggles(existing || {});
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      modalCloseBtn.focus();
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    if (!existing) {
      showBanner();
    } else {
      applyConsent(existing);
    }

    document.getElementById('cookie-accept-all').addEventListener('click', function () {
      existing = writeConsent({ preferences: true, analytics: true, marketing: true });
      hideBanner();
    });
    document.getElementById('cookie-reject-nonessential').addEventListener('click', function () {
      existing = writeConsent({ preferences: false, analytics: false, marketing: false });
      hideBanner();
    });
    document.getElementById('cookie-manage').addEventListener('click', openModal);
    modalCloseBtn.addEventListener('click', closeModal);
    document.getElementById('cookie-modal-save').addEventListener('click', function () {
      existing = writeConsent({
        preferences: prefToggle.checked,
        analytics: analyticsToggle.checked,
        marketing: marketingToggle.checked,
      });
      closeModal();
      hideBanner();
    });
    document.getElementById('cookie-accept-all-modal').addEventListener('click', function () {
      existing = writeConsent({ preferences: true, analytics: true, marketing: true });
      closeModal();
      hideBanner();
    });

    // Reopened from the footer "Cookie Settings" link on any page.
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('#cookie-settings-trigger');
      if (trigger) {
        e.preventDefault();
        openModal();
      }
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
    modal.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var focusable = modal.querySelectorAll('button, input, a[href]');
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
