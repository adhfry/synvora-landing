---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE } from '../lib/site';
import { pathFor, type Locale } from '../i18n/routes';

interface Props {
  title: string;
  description?: string;
  navVariant?: 'dark' | 'light';
  footerVariant?: 'landing' | 'default';
  active?: string;
  bodyClass?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  lang?: Locale;
  // Key into i18n/routes.ts ROUTES - resolves both hreflang alternates and
  // the language switcher's target path. Omit it (blog articles do) and
  // pass hreflangId/hreflangEn explicitly instead.
  routeKey?: string;
  hreflangId?: string;
  hreflangEn?: string | null;
}

const {
  title,
  description = 'SYNVORA Teknologi Indonesia adalah perusahaan teknologi berbasis di Sumenep yang membangun sistem perangkat lunak, produk digital, dan solusi teknologi untuk organisasi.',
  navVariant = 'light',
  footerVariant = 'default',
  active = '',
  bodyClass = 'bg-white',
  ogImage = '/og-image.png',
  ogImageAlt = SITE.name,
  ogType = 'website',
  lang = 'id',
  routeKey,
  hreflangId,
  hreflangEn,
} = Astro.props;

const idPath = hreflangId ?? (routeKey ? pathFor(routeKey, 'id') : '/');
const enPath = hreflangEn !== undefined ? hreflangEn : routeKey ? pathFor(routeKey, 'en') : null;
const switcherRouteKey = routeKey ?? 'home';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);
const ogImageType = /\.png$/i.test(ogImage)
  ? 'image/png'
  : /\.(jpe?g)$/i.test(ogImage)
    ? 'image/jpeg'
    : /\.webp$/i.test(ogImage)
      ? 'image/webp'
      : undefined;
const fullTitle = title.includes('SYNVORA') ? title : `${title} | ${SITE.name}`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const ogLocale = lang === 'en' ? 'en_US' : 'id_ID';

// Sitewide structured data - lets search engines show SYNVORA as a known
// entity (knowledge panel eligibility) and surface accurate contact info.
// Deliberately NOT localized per-language (same facts regardless of which
// page language fetched it), so it stays a single source of truth instead
// of two schemas that could drift out of sync.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  foundingDate: SITE.foundedISO,
  founder: { '@type': 'Person', name: SITE.founderName },
  url: SITE.url,
  logo: `${SITE.url}/images/logo/synvora-teknologi-indonesia-logo-bluetext.png`,
  email: SITE.email,
  telephone: SITE.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Diponegoro No.109 B, Pajinggaan, Bangselok',
    addressLocality: 'Kabupaten Sumenep',
    addressRegion: 'Jawa Timur',
    postalCode: '69416',
    addressCountry: 'ID',
  },
  sameAs: [
    SITE.social.linkedin,
    SITE.social.instagram,
    SITE.social.github,
    SITE.whatsappUrl,
  ],
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: lang === 'en' ? 'en-US' : 'id-ID',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Forced-light-by-default theme init. Must run before first paint to avoid a flash.
      // Only ever switches to dark if the user explicitly chose it before (localStorage) -
      // prefers-color-scheme is intentionally NOT consulted here.
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {idPath && <link rel="alternate" hreflang="id" href={new URL(idPath, Astro.site)} />}
    {enPath && <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />}
    {idPath && <link rel="alternate" hreflang="x-default" href={new URL(idPath, Astro.site)} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Google Analytics 4 - the measurement ID is exposed as data only; the
    actual gtag.js script is injected by CookieConsent.astro, and only once
    the visitor has granted Analytics consent (see cookie preferences). -->
    {gaMeasurementId && (
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.__SYNVORA_GA_ID__ = gaMeasurementId;
      </script>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <slot name="head" />
  </head>
  <body class:list={['text-gray-800 dark:text-gray-200 antialiased transition-colors', bodyClass]}>
    <Navbar variant={navVariant} active={active} lang={lang} routeKey={switcherRouteKey} />
    <slot />
    <Footer active={active} variant={footerVariant} lang={lang} />
    <CookieConsent locale={lang} />
  </body>
</html>
