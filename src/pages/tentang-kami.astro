---
import Layout from '../layouts/Layout.astro';
import { founder, teamMembers, SOCIAL_ICONS, SOCIAL_IMAGES } from '../data/team';
import { SITE } from '../lib/site';
---

<Layout
  title="Tentang Kami - SYNVORA Teknologi Indonesia"
  description="Kenali SYNVORA Teknologi Indonesia lebih dekat: visi, misi, nilai-nilai, perjalanan, dan budaya kerja kami dalam membangun solusi teknologi yang berdampak nyata."
  navVariant="light"
  footerVariant="default"
  active="tentang-kami"
  bodyClass="bg-white"
>
  <Fragment slot="head">
    <style is:global>
      .hero-bg {
        background-color: #0a1128;
        background-image: linear-gradient(to right, rgba(10, 17, 40, 0.95) 0%, rgba(10, 17, 40, 0.8) 50%, rgba(10, 17, 40, 0.4) 100%),
          url('https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .card-shadow {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #f3f4f6;
      }
      .timeline-line {
        position: absolute;
        top: 24px;
        left: 10%;
        right: 10%;
        height: 2px;
        background-color: #e5e7eb;
        z-index: 0;
      }
      .timeline-dot {
        position: relative;
        z-index: 10;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 50%;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px auto;
      }
      .timeline-dot.active {
        border-color: #0066ff;
        background-color: #0066ff;
        color: white;
      }
      .timeline-dot.active i {
        color: white;
      }
      .timeline-dot i {
        color: #6b7280;
      }
      .stat-bg {
        background-color: #0a1128;
        background-image: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.85)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .custom-quote::before {
        content: '\201C';
        font-size: 4rem;
        line-height: 1;
        position: absolute;
        top: -10px;
        left: -10px;
        color: rgba(255, 255, 255, 0.2);
        font-family: serif;
      }
      .dark .card-shadow {
        border-color: rgba(255, 255, 255, 0.08);
      }
      .dark .timeline-dot {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.15);
      }
      .dark .timeline-dot i {
        color: #9ca3af;
      }
      .dark .timeline-line {
        background-color: rgba(255, 255, 255, 0.1);
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-bg text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div>
        <div class="text-xs font-semibold text-gray-400 mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-white cursor-pointer">Beranda</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-white">Tentang Kami</span>
        </div>
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
          Tentang <span class="text-primary">Kami</span>
        </h1>
        <p class="text-gray-300 text-sm md:text-base mb-10 max-w-lg leading-relaxed">
          Mengenal lebih dekat SYNVORA Teknologi Indonesia, perjalanan, nilai, dan komitmen kami untuk menghadirkan solusi teknologi yang berdampak nyata.
        </p>

        <div class="border-l-4 border-primary pl-4">
          <div class="text-xs font-bold tracking-[0.2em] text-white mb-2">
            SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
          </div>
          <div class="text-xs text-gray-400">
            A Better Tomorrow Through Technology
          </div>
        </div>
      </div>

      <!-- Right: real photo from a team working session -->
      <div class="hidden lg:block relative">
        <div class="rounded-xl overflow-hidden shadow-2xl border border-white/10 relative h-[400px]">
          <img src="/images/team/pertemuan-1-synvora.jpg" alt="Tim SYNVORA dalam sesi kerja" class="w-full h-full object-cover">
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent flex flex-col justify-end items-start text-left p-6">
            <div class="text-white text-sm font-semibold leading-tight">Tim SYNVORA, dalam sesi kerja langsung.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SIAPA KAMI ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left: abstract brand panel (no office/building photo - we don't have one yet) -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-lg bg-gradient-to-br from-[#0f1a3d] to-[#0A1128] h-[400px] relative flex items-center justify-center">
          <div class="absolute top-0 left-0 w-56 h-56 bg-primary rounded-full filter blur-[90px] opacity-25"></div>
          <div class="absolute bottom-0 right-0 w-40 h-40 bg-primary rounded-full filter blur-[70px] opacity-20"></div>
          <img
            src="/images/logo/synvora-teknologi-indonesia-logo-whitetext.png"
            alt="SYNVORA Teknologi Indonesia"
            class="h-16 w-auto max-w-[300px] object-contain relative z-10"
          />
        </div>
        <!-- Floating text box -->
        <div class="absolute bottom-6 left-6 bg-white/90 backdrop-blur-sm p-6 rounded-lg shadow-lg max-w-[240px] border-l-4 border-primary">
          <div class="font-bold text-lg leading-tight" style="color:#111827">Technology Changing the Era,</div>
          <div class="font-bold text-lg leading-tight" style="color:#111827">Let's Build with Synvora</div>
          <div class="w-8 h-0.5 bg-primary mt-3"></div>
        </div>
      </div>

      <!-- Right Content -->
      <div>
        <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> SIAPA KAMI
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-6">SYNVORA Teknologi Indonesia</h2>
        <p class="text-sm text-gray-600 leading-relaxed mb-6">
          Teknologi semestinya lebih dari sekadar mendigitalkan proses yang sudah ada. Teknologi semestinya menciptakan cara kerja yang lebih baik, menghubungkan orang dan informasi, dan membuka kemungkinan baru.
        </p>
        <p class="text-sm text-gray-600 leading-relaxed mb-8">
          SYNVORA Teknologi Indonesia adalah perusahaan teknologi tahap awal (early-stage) yang berbasis di Sumenep, Jawa Timur. Kami bekerja di dua arah: membangun solusi teknologi untuk organisasi dan instansi, serta membangun produk digital milik kami sendiri dan menjajaki teknologi baru lewat riset mandiri.
        </p>

        <!-- Company Information -->
        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6 grid grid-cols-2 gap-5">
          <div>
            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Badan Hukum</div>
            <div class="text-sm font-semibold text-gray-900">{SITE.legalName}</div>
          </div>
          <div>
            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Didirikan</div>
            <div class="text-sm font-semibold text-gray-900">{SITE.foundedDisplay}</div>
          </div>
          <div>
            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Berbasis di</div>
            <div class="text-sm font-semibold text-gray-900">{SITE.addressShort}, Indonesia</div>
          </div>
          <div>
            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Pendiri & Direktur</div>
            <div class="text-sm font-semibold text-gray-900">{SITE.founderName}</div>
          </div>
          <div class="col-span-2">
            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Industri</div>
            <div class="text-sm font-semibold text-gray-900">Teknologi / Software & SaaS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= VISI, MISI, NILAI ================= -->
  <section class="py-16 bg-gray-50 px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Visi -->
      <div class="bg-white p-8 rounded-2xl card-shadow">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
          <i class="fa-regular fa-eye"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-lg mb-4">Visi</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          Membangun solusi teknologi yang relevan bagi organisasi di Indonesia, sembari mengembangkan produk digital kami sendiri.
        </p>
      </div>

      <!-- Misi -->
      <div class="bg-white p-8 rounded-2xl card-shadow">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
          <i class="fa-solid fa-bullseye"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-lg mb-4">Misi</h3>
        <ul class="space-y-4 text-sm text-gray-500">
          <li class="flex gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0">1</span>
            Mengembangkan solusi teknologi berkualitas dan relevan.
          </li>
          <li class="flex gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0">2</span>
            Memberikan layanan profesional dan berorientasi pada kepuasan klien.
          </li>
          <li class="flex gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0">3</span>
            Mendorong inovasi berkelanjutan di setiap lini bisnis.
          </li>
          <li class="flex gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0">4</span>
            Berkontribusi pada transformasi digital untuk Indonesia yang lebih maju.
          </li>
        </ul>
      </div>

      <!-- Nilai-Nilai -->
      <div class="bg-white p-8 rounded-2xl card-shadow">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
          <i class="fa-solid fa-gem"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-lg mb-4">Nilai-Nilai Kami</h3>
        <div class="space-y-4 text-sm text-gray-500">
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">S</span>
            <div>
              <div class="font-semibold text-gray-800 dark:text-gray-200">Synchronous</div>
              <div class="text-xs">Selaras dalam tujuan dan langkah.</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">I</span>
            <div>
              <div class="font-semibold text-gray-800 dark:text-gray-200">Innovation</div>
              <div class="text-xs">Selalu mencari cara yang lebih baik.</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">E</span>
            <div>
              <div class="font-semibold text-gray-800 dark:text-gray-200">Evolution</div>
              <div class="text-xs">Terus berkembang mengikuti perubahan.</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-blue-100 text-primary flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">E</span>
            <div>
              <div class="font-semibold text-gray-800 dark:text-gray-200">Era</div>
              <div class="text-xs">Membangun masa depan yang lebih baik.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= COMPANY SNAPSHOT ================= -->
  <section class="py-16 px-8">
    <div class="max-w-7xl mx-auto stat-bg rounded-3xl p-12 text-white flex flex-col lg:flex-row justify-between items-center relative overflow-hidden shadow-2xl">
      <!-- Facts Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 w-full lg:w-2/3 mb-12 lg:mb-0">
        <div class="flex flex-col items-center lg:items-start">
          <i class="fa-solid fa-building-columns text-3xl text-blue-300 mb-4"></i>
          <div class="text-xl font-extrabold mb-1">{SITE.foundedDisplay}</div>
          <div class="text-xs text-gray-300 text-center lg:text-left">Didirikan</div>
        </div>
        <div class="flex flex-col items-center lg:items-start">
          <i class="fa-solid fa-location-dot text-3xl text-blue-300 mb-4"></i>
          <div class="text-xl font-extrabold mb-1">Sumenep</div>
          <div class="text-xs text-gray-300 text-center lg:text-left">Berbasis di Jawa Timur</div>
        </div>
        <div class="flex flex-col items-center lg:items-start">
          <i class="fa-solid fa-cube text-3xl text-blue-300 mb-4"></i>
          <div class="text-xl font-extrabold mb-1">Produk & Solusi</div>
          <div class="text-xs text-gray-300 text-center lg:text-left">Fokus utama kami</div>
        </div>
        <div class="flex flex-col items-center lg:items-start">
          <i class="fa-solid fa-users text-3xl text-blue-300 mb-4"></i>
          <div class="text-xl font-extrabold mb-1">Multidisiplin</div>
          <div class="text-xs text-gray-300 text-center lg:text-left">Tim yang membangunnya</div>
        </div>
      </div>

      <!-- Quote -->
      <div class="w-full lg:w-1/3 relative pl-8 border-l border-white/20">
        <div class="relative">
          <i class="fa-solid fa-quote-left text-4xl text-white/20 absolute -top-4 -left-4"></i>
          <p class="text-sm text-gray-200 italic leading-relaxed relative z-10 mb-4">
            "Inovasi bukan hanya tentang teknologi, tetapi tentang manusia dan masa depan yang lebih baik."
          </p>
          <div class="w-12 h-0.5 bg-primary mb-3"></div>
          <div class="text-xs font-bold tracking-widest text-gray-400">SYNVORA TEKNOLOGI INDONESIA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BUDAYA KAMI ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div>
        <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> BUDAYA KAMI
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-6">Berkembang Bersama<br>dengan Nilai yang Kuat</h2>
        <p class="text-sm text-gray-600 leading-relaxed mb-8">
          Kami percaya bahwa hasil terbaik lahir dari kolaborasi, kepercayaan, dan lingkungan kerja yang positif. SYNVORA adalah tempat di mana ide dihargai, inovasi didorong, dan setiap individu memiliki peran berarti dalam menciptakan dampak.
        </p>
        <a href="/karier" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold inline-flex items-center gap-2 transition">
          Bergabung Bersama Kami <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <!-- Right Image Grid -->
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2 relative rounded-2xl overflow-hidden shadow-lg h-64">
          <img src="/images/team/pertemuan-2-synvora.jpg" alt="Tim SYNVORA dalam pertemuan kerja" class="w-full h-full object-cover">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-6">
            <div class="text-white">
              <div class="text-lg font-bold leading-tight">Great<br>People<br>Build<br>Great<br>Solutions</div>
            </div>
          </div>
        </div>
        <div class="col-span-2 relative rounded-2xl overflow-hidden shadow-lg h-40 bg-[#0A1128] p-6 flex items-center">
          <div>
            <i class="fa-solid fa-quote-left text-2xl text-primary mb-2"></i>
            <p class="text-sm md:text-lg lg:text-xl text-gray-300 italic mb-2 leading-snug">"Tim yang solid adalah fondasi dari setiap inovasi besar."</p>
            <div class="w-6 h-0.5 bg-primary"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TIM KAMI ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> TIM KAMI
      </div>
      <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-6">Orang-Orang di Balik SYNVORA</h2>
      <p class="text-sm text-gray-600 leading-relaxed mb-16 max-w-2xl">
        Sekelompok individu yang membangun solusi teknologi dan produk digital SYNVORA, dari perancangan hingga rilis.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-stretch">
        <!-- Team grid -->
        <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {teamMembers.map((member) => (
            <div class="bg-white p-8 rounded-2xl card-shadow text-center flex flex-col items-center">
              {member.photo ? (
                <img src={member.photo} alt={member.name} class="w-16 h-16 rounded-full object-cover mb-5" />
              ) : (
                <div class="w-16 h-16 rounded-full bg-blue-50 text-primary flex items-center justify-center text-xl font-bold mb-5">
                  {member.initials}
                </div>
              )}
              <div class="font-bold text-gray-900 text-base mb-1">{member.name}</div>
              <div class="text-xs text-gray-500 mb-3">{member.role}</div>
              {member.socials && member.socials.length > 0 && (
                <div class="flex items-center gap-3 mt-auto pt-2">
                  {member.socials.map((social) => (
                    <a
                      href={social.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${member.name} - ${social.platform}`}
                      class="w-8 h-8 rounded-full overflow-hidden border border-gray-200 text-gray-400 flex items-center justify-center hover:border-primary hover:text-primary transition text-xs"
                    >
                      {SOCIAL_IMAGES[social.platform] ? (
                        <img src={SOCIAL_IMAGES[social.platform]} alt={social.platform} class="w-full h-full object-cover" />
                      ) : (
                        <i class={SOCIAL_ICONS[social.platform]}></i>
                      )}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Founder card -->
        <div class="lg:col-span-2 bg-[#0A1128] rounded-2xl p-10 text-white relative overflow-hidden flex flex-col">
          <div class="absolute top-0 right-0 w-40 h-40 bg-primary rounded-full filter blur-[70px] opacity-30"></div>
          <div class="relative z-10 flex flex-col items-center text-center flex-1">
            <img
              src={founder.photo}
              alt={founder.name}
              class="w-32 h-32 rounded-full object-cover border-4 border-white/10 mb-6"
            />
            <div class="font-extrabold text-2xl mb-1">{founder.name}</div>
            <div class="text-xs font-bold text-primary tracking-widest mb-6">{founder.role.toUpperCase()}</div>

            <div class="relative mb-8">
              <i class="fa-solid fa-quote-left text-3xl text-white/10 absolute -top-3 -left-4"></i>
              <p class="text-sm text-gray-300 italic leading-relaxed relative z-10">{founder.quote}</p>
            </div>

            <!-- Kartu nama -->
            <div class="w-full mb-8 rounded-xl overflow-hidden border border-white/10 shadow-lg">
              <img
                src="/images/team/kartunama-ahda.jpeg"
                alt={`Kartu nama ${founder.name} - ${founder.role}`}
                class="w-full h-auto object-cover"
              />
            </div>

            <div class="flex items-center gap-3 mt-auto">
              {founder.socials?.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${founder.name} - ${social.platform}`}
                  class="w-10 h-10 rounded-full overflow-hidden bg-white/10 text-white flex items-center justify-center hover:bg-primary transition"
                >
                  {SOCIAL_IMAGES[social.platform] ? (
                    <img src={SOCIAL_IMAGES[social.platform]} alt={social.platform} class="w-full h-full object-cover" />
                  ) : (
                    <i class={SOCIAL_ICONS[social.platform]}></i>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PERJALANAN KAMI ================= -->
  <section class="py-24 bg-gray-50 px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> PERJALANAN KAMI
      </div>
      <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-16">Tonggak Penting</h2>

      <div class="relative">
        <!-- Line -->
        <div class="hidden md:block absolute top-6 left-0 right-0 h-0.5 bg-gray-200 z-0"></div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative z-10">
          <!-- 2024 -->
          <div class="text-center">
            <div class="timeline-dot">
              <i class="fa-solid fa-flag text-sm"></i>
            </div>
            <div class="text-primary font-bold text-lg mb-2">2024</div>
            <div class="font-bold text-gray-900 mb-1">Eksplorasi Teknologi Awal</div>
            <div class="text-xs text-gray-500">Gagasan dan visi di balik SYNVORA mulai terbentuk.</div>
          </div>
          <!-- 2025 -->
          <div class="text-center">
            <div class="timeline-dot">
