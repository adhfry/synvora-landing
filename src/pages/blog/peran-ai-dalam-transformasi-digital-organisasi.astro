---
import BlogArticleLayout from '../../components/BlogArticleLayout.astro';
import { blogPosts } from '../../data/blogPosts';

const post = blogPosts.find((p) => p.slug === 'peran-ai-dalam-transformasi-digital-organisasi')!;
---

<BlogArticleLayout
  post={post}
  authorRole="CEO & Founder SYNVORA"
  overlayLines={['From', 'Ideas', 'to Real', 'Solutions']}
  quote="AI bukan tentang menggantikan manusia, tetapi tentang memperkuat kemampuan manusia untuk membuat keputusan yang lebih baik, lebih cepat, dan lebih tepat."
  tags={post.tags}
  tocItems={[
    'Mengapa AI Penting untuk Transformasi Digital?',
    'Contoh Implementasi AI di Berbagai Sektor',
    'Tantangan dalam Implementasi AI',
    'Kesimpulan',
  ]}
>
  <!-- Section 1 -->
  <div class="mb-10">
    <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-4">Mengapa AI Penting untuk Transformasi Digital?</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">Transformasi digital bukan hanya tentang menggantikan <strong>sistem manual</strong> menjadi digital, tetapi tentang bagaimana teknologi membantu organisasi bekerja lebih efektif, efisien, dan berorientasi pada hasil. Dalam konteks ini, AI berperan sebagai enabler yang mampu:</p>

    <ul class="space-y-4">
      <li class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg shrink-0">
          <i class="fa-solid fa-gears"></i>
        </div>
        <div>
          <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-1">Mengotomatisasi Proses</h4>
          <p class="text-xs text-gray-500 dark:text-gray-400">Mengurangi pekerjaan repetitif sehingga SDM dapat fokus pada hal yang lebih strategis.</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg shrink-0">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <div>
          <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-1">Meningkatkan Akurasi</h4>
          <p class="text-xs text-gray-500 dark:text-gray-400">AI mampu menganalisis data dalam jumlah besar dengan tingkat kesalahan yang lebih rendah.</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg shrink-0">
          <i class="fa-regular fa-lightbulb"></i>
        </div>
        <div>
          <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-1">Memberikan Insight Lebih Dalam</h4>
          <p class="text-xs text-gray-500 dark:text-gray-400">Membantu pengambilan keputusan berbasis data secara real-time.</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg shrink-0">
          <i class="fa-solid fa-users"></i>
        </div>
        <div>
          <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-1">Meningkatkan Pengalaman Pengguna</h4>
          <p class="text-xs text-gray-500 dark:text-gray-400">Layanan yang lebih cepat, personal, dan responsif.</p>
        </div>
      </li>
    </ul>
  </div>

  <!-- Section 2 -->
  <div class="mb-10">
    <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-4">Contoh Implementasi AI di Berbagai Sektor</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">AI telah diterapkan di berbagai sektor, baik pemerintahan, kesehatan, maupun bisnis swasta. Berikut beberapa contoh nyata:</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card-shadow rounded-2xl overflow-hidden">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=600" alt="Pemerintahan" class="w-full h-32 object-cover">
        <div class="p-5">
          <div class="flex items-center gap-2 mb-2">
            <i class="fa-solid fa-building-columns text-primary text-sm"></i>
            <h3 class="font-bold text-gray-900 dark:text-white text-sm">Pemerintahan</h3>
          </div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed">Analisis data kependudukan, prediksi kebutuhan layanan publik, dan chatbot layanan masyarakat.</p>
        </div>
      </div>
      <div class="card-shadow rounded-2xl overflow-hidden">
        <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&q=80&w=600" alt="Kesehatan" class="w-full h-32 object-cover">
        <div class="p-5">
          <div class="flex items-center gap-2 mb-2">
            <i class="fa-solid fa-heart-pulse text-primary text-sm"></i>
            <h3 class="font-bold text-gray-900 dark:text-white text-sm">Kesehatan</h3>
          </div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed">Deteksi dini penyakit, otomatisasi hasil laboratorium, dan analisis data pasien.</p>
        </div>
      </div>
      <div class="card-shadow rounded-2xl overflow-hidden">
        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=600" alt="Bisnis" class="w-full h-32 object-cover">
        <div class="p-5">
          <div class="flex items-center gap-2 mb-2">
            <i class="fa-solid fa-briefcase text-primary text-sm"></i>
            <h3 class="font-bold text-gray-900 dark:text-white text-sm">Bisnis</h3>
          </div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed">Personalisasi layanan pelanggan, analisis perilaku konsumen, dan optimasi operasional.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 3 -->
  <div class="mb-10">
    <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-4">Tantangan dalam Implementasi AI</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">Meskipun memiliki banyak manfaat, penerapan AI juga menghadapi beberapa tantangan, seperti:</p>
    <ul class="space-y-3">
      <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-300">
        <i class="fa-solid fa-circle-check text-primary mt-0.5 text-xs"></i> Kualitas dan ketersediaan data yang memadai.
      </li>
      <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-300">
        <i class="fa-solid fa-circle-check text-primary mt-0.5 text-xs"></i> Kebutuhan SDM dengan kompetensi digital.
      </li>
      <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-300">
        <i class="fa-solid fa-circle-check text-primary mt-0.5 text-xs"></i> Aspek keamanan dan privasi data.
      </li>
      <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-300">
        <i class="fa-solid fa-circle-check text-primary mt-0.5 text-xs"></i> Biaya implementasi yang relatif tinggi.
      </li>
    </ul>
  </div>

  <!-- Section 4 -->
  <div class="mb-10">
    <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-4">Kesimpulan</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">AI adalah bagian penting dari transformasi digital yang mampu memberikan nilai nyata bagi organisasi. Dengan strategi yang tepat, AI dapat menjadi katalis untuk menciptakan layanan yang lebih baik, efisien, dan berorientasi pada masa depan.</p>
  </div>
</BlogArticleLayout>
