---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Karir - SYNVORA Teknologi Indonesia"
  description="Kenali budaya kerja dan benefit di SYNVORA Teknologi Indonesia. Belum ada posisi terbuka saat ini, namun kami selalu terbuka untuk berkenalan dengan talenta terbaik."
  navVariant="light"
  footerVariant="default"
  active="karier"
  lang="id"
  routeKey="careers"
  bodyClass="bg-white"
>
  <Fragment slot="head">
    <style is:global>
      .hero-bg {
        background-color: #0a1128;
        /* Placeholder image: Menyesuaikan dengan gambar tim bekerja */
        background-image: linear-gradient(to right, rgba(10, 17, 40, 0.95) 0%, rgba(10, 17, 40, 0.8) 40%, rgba(10, 17, 40, 0.4) 100%),
          url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .benefit-card {
        transition: all 0.3s ease;
      }
      .benefit-card:hover {
        transform: translateY(-5px);
      }
      .cta-bg {
        background-color: #0a1128;
        background-image: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.85)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-bg text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div>
        <!-- Breadcrumb -->
        <div class="text-xs font-semibold text-gray-400 mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-white cursor-pointer">Beranda</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-white">Karier</span>
        </div>

        <!-- Title -->
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
          Bersama SYNVORA<br><span class="text-primary">Bangun Masa Depanmu</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-gray-300 text-sm md:text-base mb-10 max-w-lg leading-relaxed">
          Di SYNVORA, kami percaya bahwa talenta luar biasa adalah kunci untuk menciptakan solusi teknologi yang berdampak nyata bagi Indonesia.
        </p>

        <!-- Tagline -->
        <div class="border-l-4 border-primary pl-4">
          <div class="text-xs font-bold tracking-[0.2em] text-white mb-2">
            SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
          </div>
          <div class="text-xs text-gray-400">
            A Better Tomorrow Through Technology
          </div>
        </div>
      </div>

      <!-- Right Floating Box -->
      <div class="hidden lg:flex justify-end relative">
        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl max-w-xs relative z-20">
          <div class="text-3xl font-extrabold text-white leading-tight mb-4">
            Great<br>People<br>Build<br>Greater<br>Solutions
          </div>
          <div class="w-12 h-1 bg-primary mb-6"></div>

          <!-- Inner Text -->
          <div class="text-sm text-gray-200 leading-relaxed mb-4">
            Tumbuh<br>Berkembang<br>Berdampak
          </div>
          <div class="w-12 h-0.5 bg-primary"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CULTURE & PERKS ================= -->
  <section class="py-16 bg-white px-8 border-b border-gray-100">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-center gap-8">
      <!-- Perks Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 w-full lg:w-3/4">
        <!-- Perk 1 -->
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-rocket"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Lingkungan Kerja Kolaboratif</h3>
          <p class="text-[11px] text-gray-500 leading-relaxed">Bertumbuh bersama tim yang suportif.</p>
        </div>
        <!-- Perk 2 -->
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
            <i class="fa-regular fa-lightbulb"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Kesempatan Berkembang</h3>
          <p class="text-[11px] text-gray-500 leading-relaxed">Dukungan penuh untuk pengembangan karier Anda.</p>
        </div>
        <!-- Perk 3 -->
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-users"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Proyek Bermakna</h3>
          <p class="text-[11px] text-gray-500 leading-relaxed">Terlibat dalam solusi teknologi yang memberi dampak nyata.</p>
        </div>
        <!-- Perk 4 -->
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-heart"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Work-Life Balance</h3>
          <p class="text-[11px] text-gray-500 leading-relaxed">Kami percaya produktivitas lahir dari keseimbangan.</p>
        </div>
      </div>

      <!-- Quote -->
      <div class="w-full lg:w-1/4 relative pl-6 border-l-2 border-primary">
        <i class="fa-solid fa-quote-left text-2xl text-blue-100 absolute -top-2 left-2"></i>
        <p class="text-xs text-gray-500 italic relative z-10 mb-3">"Talenta yang bahagia menciptakan solusi yang luar biasa."</p>
        <div class="text-[10px] font-bold tracking-widest text-primary">SYNVORA TEKNOLOGI INDONESIA</div>
      </div>
    </div>
  </section>

  <!-- ================= JOB OPENINGS SECTION ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- Left Column: Title & Info -->
      <div class="lg:col-span-1">
        <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span> POSISI TERBUKA
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-4">
          Temukan<br>Kesempatanmu
        </h2>
        <p class="text-sm text-gray-500 mb-8 leading-relaxed">
          Jelajahi peluang karier di SYNVORA dan jadilah bagian dari tim yang membangun masa depan dengan teknologi.
        </p>

        <!-- Real photo from a team working session -->
        <div class="relative rounded-2xl overflow-hidden shadow-lg mb-6 h-48">
          <img src="/images/team/pertemuan-2-synvora.jpg" alt="Tim SYNVORA dalam pertemuan kerja" class="w-full h-full object-cover">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent flex flex-col justify-end items-start text-left p-6">
            <div class="text-white text-sm font-semibold">Tim SYNVORA, bekerja langsung.</div>
          </div>
        </div>

        <!-- Quote Box -->
        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 relative">
          <i class="fa-solid fa-quote-left text-2xl text-blue-100 absolute top-4 left-4"></i>
          <p class="text-xs text-gray-600 italic relative z-10 mb-4 pl-4">"Tempat yang tepat untuk belajar, berkarya, dan memberi dampak nyata."</p>
          <div class="w-8 h-0.5 bg-primary mb-2 ml-4"></div>
          <div class="text-[9px] font-bold tracking-widest text-primary ml-4">SYNVORA TEKNOLOGI INDONESIA</div>
        </div>
      </div>

      <!-- Right Column: Coming Soon -->
      <div class="lg:col-span-2">
        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-12 h-full flex flex-col items-center justify-center text-center">
          <div class="w-16 h-16 bg-blue-50 text-primary rounded-2xl flex items-center justify-center text-3xl mb-6">
            <i class="fa-regular fa-clock"></i>
          </div>
          <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary rounded-full"></span> SEGERA HADIR
          </div>
          <h3 class="text-2xl font-extrabold text-gray-900 mb-4">Belum Ada Posisi Terbuka Saat Ini</h3>
          <p class="text-sm text-gray-500 max-w-md leading-relaxed mb-8">
            Saat ini SYNVORA belum membuka lowongan baru. Kami selalu terbuka untuk berkenalan dengan talenta terbaik, jadi pantau halaman ini secara berkala untuk pembaruan.
          </p>
          <a href="/hubungi-kami" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold flex items-center gap-2 transition">
            Hubungi Kami <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BENEFITS SECTION ================= -->
  <section class="py-16 bg-gray-50 px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center justify-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span> BENEFIT
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-4">Lebih dari<br>Sekadar Pekerjaan</h2>
        <p class="text-sm text-gray-500 max-w-2xl mx-auto">Kami menyediakan berbagai fasilitas untuk mendukung kesejahteraan dan perkembangan karier Anda.</p>
      </div>

      <!-- Benefits Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <!-- Benefit 1 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-regular fa-credit-card"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Gaji Kompetitif</h3>
        </div>
        <!-- Benefit 2 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Tunjangan Kesehatan</h3>
        </div>
        <!-- Benefit 3 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-solid fa-house"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Work from Anywhere</h3>
        </div>
        <!-- Benefit 4 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Pelatihan & Sertifikasi</h3>
        </div>
        <!-- Benefit 5 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-solid fa-laptop"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Peralatan Kerja Modern</h3>
        </div>
        <!-- Benefit 6 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-solid fa-people-group"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Team Building</h3>
        </div>
        <!-- Benefit 7 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-regular fa-calendar-check"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Cuti Fleksibel</h3>
        </div>
        <!-- Benefit 8 -->
        <div class="benefit-card">
          <div class="w-14 h-14 bg-white text-primary rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-sm border border-gray-100">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1">Jenjang Karier Jelas</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= WHY JOIN SECTION ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span> KENAPA SYNVORA
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-4">Bergabung di Tahap Awal</h2>
        <p class="text-sm text-gray-500 max-w-xl">SYNVORA masih perusahaan tahap awal. Bergabung sekarang berarti ikut membentuk arah tim, produk, dan cara kerja kami sejak tahap formatif.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
          <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-layer-group"></i></div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Kerja Lintas Peran</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Tim yang masih kecil berarti kesempatan terlibat langsung di solusi klien, produk sendiri, maupun riset dan inovasi.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
          <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-seedling"></i></div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Ikut Membentuk Arah</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Keputusan tentang produk, proses, dan budaya kerja masih terbuka untuk dibentuk bersama di tahap ini.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
          <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-handshake"></i></div>
          <h3 class="font-bold text-gray-900 text-sm mb-2">Transparan Apa Adanya</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Kami jujur soal posisi kami sebagai perusahaan baru: masih membangun, bukan berpura-pura sudah besar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BOTTOM CTA ================= -->
  <section class="py-16 px-8">
    <div class="max-w-7xl mx-auto cta-bg rounded-3xl p-12 flex flex-col md:flex-row justify-between items-center relative overflow-hidden shadow-2xl">
      <!-- Background glow -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary rounded-full filter blur-[100px] opacity-20"></div>

      <div class="z-10 mb-8 md:mb-0 max-w-2xl">
        <div class="text-xs font-bold text-primary tracking-widest mb-2">SIAP BERGABUNG?</div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-tight mb-4">
          Wujudkan Potensimu<br>Bersama SYNVORA
        </h2>
        <p class="text-sm text-gray-300">
          Mari bangun solusi teknologi yang lebih baik untuk Indonesia. Temukan posisi yang sesuai dan mulai perjalanan karier Anda bersama kami.
        </p>
      </div>

      <div class="flex gap-4 z-10">
        <a href="/hubungi-kami" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold flex items-center gap-2 transition">
          Hubungi Kami <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>
</Layout>
