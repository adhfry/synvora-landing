---
import Layout from '../layouts/Layout.astro';
import { portfolioProjects, getProjectsByKind, type PortfolioProject, type ProjectStatus } from '../data/portfolioProjects';
import { teamMembers, founder } from '../data/team';

const allPeople = [founder, ...teamMembers];
function findPerson(name: string) {
  return allPeople.find((p) => p.name === name);
}

const statusBadge: Record<ProjectStatus, string> = {
  Live: 'bg-green-50 text-green-700 dark:bg-green-400/10 dark:text-green-400',
  'In Development': 'bg-amber-50 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400',
  Prototype: 'bg-blue-50 text-primary dark:bg-primary/10',
  Completed: 'bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300',
};

const products = getProjectsByKind('product');
const innovations = getProjectsByKind('innovation');
const solutions = getProjectsByKind('solution');

const groups: { key: string; eyebrow: string; title: string; description: string; items: PortfolioProject[] }[] = [
  {
    key: 'product',
    eyebrow: 'PRODUK',
    title: 'Produk yang Kami Bangun Sendiri',
    description: 'Produk SaaS milik SYNVORA sendiri, dikembangkan dan dioperasikan langsung oleh tim kami.',
    items: products,
  },
  {
    key: 'solution',
    eyebrow: 'SOLUSI TEKNOLOGI TERPILIH',
    title: 'Sistem yang Kami Bangun untuk Klien & Instansi',
    description: 'Website dan sistem yang dibangun untuk kebutuhan klien dan instansi tertentu.',
    items: solutions,
  },
  {
    key: 'innovation',
    eyebrow: 'INOVASI & R&D',
    title: 'Inisiatif Riset dan Inovasi Mandiri',
    description: 'Proyek riset dan inovasi yang kami gagas sendiri untuk Sumenep, bukan pesanan klien, beberapa diajukan ke program inovasi daerah.',
    items: innovations,
  },
];

const kindFilters: { value: string; label: string }[] = [
  { value: 'all', label: 'Semua' },
  { value: 'product', label: 'Produk' },
  { value: 'solution', label: 'Solusi' },
  { value: 'innovation', label: 'Inovasi & R&D' },
];

const statusFilters: { value: string; label: string }[] = [
  { value: 'all', label: 'Semua Status' },
  { value: 'Live', label: 'Live' },
  { value: 'Completed', label: 'Completed' },
  { value: 'In Development', label: 'In Development' },
  { value: 'Prototype', label: 'Prototype' },
];

// Searchable text per project: name, description, category, technology
// (feature bullets double as this - many name specific tech), tags, status.
function searchText(project: PortfolioProject): string {
  return [
    project.title,
    project.shortDescription,
    project.overview,
    project.problem,
    project.solution,
    project.status,
    ...project.categories,
    ...project.features,
  ]
    .join(' ')
    .toLowerCase();
}
---

<Layout
  title="Portofolio - SYNVORA Teknologi Indonesia"
  description="Portofolio SYNVORA Teknologi Indonesia: produk yang kami bangun sendiri, solusi teknologi untuk klien & instansi, dan inisiatif riset & inovasi mandiri di Sumenep."
  navVariant="light"
  footerVariant="default"
  active="portfolio"
  bodyClass="bg-white"
>
  <Fragment slot="head">
    <style is:global>
      .hero-bg {
        background-color: #0a1128;
        background-image: linear-gradient(to right, rgba(10, 17, 40, 0.95) 0%, rgba(10, 17, 40, 0.8) 40%, rgba(10, 17, 40, 0.4) 100%),
          url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .card-shadow {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #f3f4f6;
      }
      .cta-bg {
        background-color: #0a1128;
        background-image: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.85)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .dark .card-shadow {
        border-color: rgba(255, 255, 255, 0.08);
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-bg text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <div>
        <div class="text-xs font-semibold text-gray-400 mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-white cursor-pointer">Beranda</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-white">Portfolio</span>
        </div>

        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
          Portofolio <span class="text-primary">Kami</span>
        </h1>

        <p class="text-gray-300 text-sm md:text-base mb-10 max-w-lg leading-relaxed">
          Produk yang kami bangun sendiri, solusi teknologi yang kami kembangkan untuk klien dan instansi, serta inisiatif riset dan inovasi mandiri di Sumenep.
        </p>

        <div class="border-l-4 border-primary pl-4">
          <div class="text-xs font-bold tracking-[0.2em] text-white mb-2">
            SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
          </div>
          <div class="text-xs text-gray-400">
            A Better Tomorrow Through Technology
          </div>
        </div>
      </div>

      <div class="hidden lg:flex justify-end relative">
        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl max-w-sm relative z-20">
          <div class="text-3xl font-extrabold text-white leading-tight mb-4">
            Produk,<br>Solusi,<br>dan<br>Inovasi
          </div>
          <div class="w-12 h-1 bg-primary mb-6"></div>

          <div class="bg-[#0A1128]/80 p-4 rounded-xl border border-white/10 flex items-start gap-3">
            <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0">
              <i class="fa-solid fa-lightbulb text-white"></i>
            </div>
            <div>
              <div class="text-xs font-bold text-white mb-1">Tiga Jalur, Satu Arah</div>
              <div class="text-[10px] text-gray-400 leading-tight">Produk sendiri, solusi untuk klien, dan riset mandiri - semuanya kami kerjakan secara terbuka.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SEARCH & FILTER ================= -->
  <section class="py-10 px-8 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-4 lg:items-center lg:justify-between mb-4">
        <div class="relative flex-1 lg:max-w-md">
          <label for="portfolio-search" class="sr-only">Cari proyek, produk, atau teknologi</label>
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input
            type="text"
            id="portfolio-search"
            placeholder="Search projects, products, technologies..."
            class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-full text-xs focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
            autocomplete="off"
          />
        </div>

        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori">
          {kindFilters.map((f) => (
            <button
              type="button"
              class="filter-kind-btn px-4 py-2 rounded-full text-xs font-semibold border border-gray-200 text-gray-600 hover:border-primary hover:text-primary transition aria-pressed:bg-primary aria-pressed:text-white aria-pressed:border-primary"
              data-kind={f.value}
              aria-pressed={f.value === 'all' ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <label for="portfolio-status" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Status</label>
          <select
            id="portfolio-status"
            class="border border-gray-200 rounded-full text-xs font-semibold text-gray-600 px-4 py-2.5 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
          >
            {statusFilters.map((s) => <option value={s.value}>{s.label}</option>)}
          </select>
        </div>
      </div>

      <p id="portfolio-result-count" class="text-xs text-gray-400" aria-live="polite"></p>
    </div>
  </section>

  <p id="portfolio-empty-state" class="hidden text-center py-16 px-8">
    <span class="block text-sm font-bold text-gray-700 mb-1">No projects found</span>
    <span class="block text-xs text-gray-500">Try another search term or category.</span>
  </p>

  {groups.map((group) => group.items.length > 0 && (
    <section class="portfolio-group py-20 bg-white px-8 border-b border-gray-100 last:border-b-0" data-kind={group.key}>
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary rounded-full"></span> {group.eyebrow}
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-4">{group.title}</h2>
          <p class="text-sm text-gray-500 max-w-xl">{group.description}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {group.items.map((project) => (
            <div
              class="portfolio-card bg-white rounded-2xl card-shadow overflow-hidden flex flex-col group"
              data-kind={group.key}
              data-status={project.status}
              data-search={searchText(project)}
            >
              <div class="h-44 relative overflow-hidden">
                <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500">
                <div class="absolute top-3 left-3">
                  <span class={`px-3 py-1 rounded-full text-[10px] font-bold backdrop-blur ${statusBadge[project.status]}`}>{project.status}</span>
                </div>
                {project.year && (
                  <div class="absolute top-3 right-3 bg-white/90 backdrop-blur px-2.5 py-1 rounded text-[10px] font-bold text-gray-700">{project.year}</div>
                )}
              </div>
              <div class="p-6 flex-1 flex flex-col">
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {project.categories.map((cat) => (
                    <span class="bg-gray-100 dark:bg-white/5 px-2.5 py-0.5 rounded text-[10px] font-semibold text-gray-600 dark:text-gray-300">{cat}</span>
                  ))}
                </div>
                <h3 class="font-bold text-gray-900 text-sm mb-2">{project.title}</h3>
                <p class="text-[11px] text-gray-500 mb-4 leading-relaxed"><span class="font-semibold text-gray-700">Solusi:</span> {project.solution}</p>
                <div class="flex items-center justify-between gap-3 mt-auto">
                  <button type="button" data-modal-target={project.id} class="text-primary text-xs font-semibold flex items-center gap-2 group-hover:gap-3 transition-all">
                    Lihat Detail <i class="fa-solid fa-arrow-right"></i>
                  </button>
                  {project.link ? (
                    <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary transition" aria-label="Kunjungi situs">
                      <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                  ) : (
                    <span class="text-gray-400 text-[10px] font-semibold flex items-center gap-1.5" title="Belum ada tautan publik"><i class="fa-solid fa-lock"></i></span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ================= THREE PILLARS RECAP ================= -->
  <section class="py-16 px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl card-shadow p-6">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-cube"></i></div>
        <h3 class="font-bold text-gray-900 text-sm mb-2">Produk</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Produk SaaS yang kami bangun dan operasikan sendiri, seperti Synctappy.</p>
      </div>
      <div class="bg-white rounded-2xl card-shadow p-6">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-handshake"></i></div>
        <h3 class="font-bold text-gray-900 text-sm mb-2">Solusi Teknologi</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Sistem dan website yang kami bangun untuk kebutuhan klien dan instansi.</p>
      </div>
      <div class="bg-white rounded-2xl card-shadow p-6">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-flask"></i></div>
        <h3 class="font-bold text-gray-900 text-sm mb-2">Inovasi & R&D</h3>
        <p class="text-xs text-gray-500 leading-relaxed">Inisiatif riset dan inovasi yang kami gagas sendiri untuk Sumenep.</p>
      </div>
    </div>
  </section>

  <!-- ================= PROJECT DETAIL MODAL ================= -->
  <div id="project-modal-overlay" class="hidden fixed inset-0 bg-black/60 z-[100] items-center justify-center p-4">
    <div class="bg-white dark:bg-[#0f1a3d] rounded-2xl max-w-2xl w-full max-h-[85vh] overflow-y-auto relative shadow-2xl">
      <button type="button" class="modal-close-btn absolute top-4 right-4 w-9 h-9 rounded-full bg-white/90 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-gray-100 dark:hover:bg-white/20 transition z-10" aria-label="Tutup">
        <i class="fa-solid fa-xmark"></i>
      </button>
      {portfolioProjects.map((project) => (
        <div class="project-modal-panel hidden" id={`modal-${project.id}`}>
          <div class="h-56 relative overflow-hidden rounded-t-2xl">
            <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top">
            <div class="absolute top-3 left-6 flex flex-wrap gap-1.5">
              <span class={`px-3 py-1 rounded-full text-[10px] font-bold backdrop-blur ${statusBadge[project.status]}`}>{project.status}</span>
              {project.year && <span class="bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-700">{project.year}</span>}
            </div>
            <div class="absolute bottom-3 left-6 flex flex-wrap gap-1.5">
              {project.categories.map((cat) => (
                <span class="bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800 shadow-sm">{cat}</span>
              ))}
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-xl font-extrabold text-gray-900 dark:text-white mb-3">{project.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">{project.overview}</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              <div class="bg-gray-50 dark:bg-white/5 rounded-xl p-4">
                <h4 class="text-[11px] font-bold text-primary tracking-widest mb-2">MASALAH</h4>
                <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">{project.problem}</p>
              </div>
              <div class="bg-gray-50 dark:bg-white/5 rounded-xl p-4">
                <h4 class="text-[11px] font-bold text-primary tracking-widest mb-2">SOLUSI</h4>
                <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">{project.solution}</p>
              </div>
            </div>

            <div class="mb-6">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-user-gear"></i> PERAN SYNVORA
              </h4>
              <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">{project.role}</p>
            </div>

            <div class="mb-6">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-list-check"></i> FITUR UTAMA
              </h4>
              <ul class="space-y-2">
                {project.features.map((f) => (
                  <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-circle-check text-primary mt-0.5 text-[10px]"></i> {f}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mb-6">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-thumbs-up"></i> KELEBIHAN
              </h4>
              <ul class="space-y-2">
                {project.benefits.map((b) => (
                  <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-circle-check text-primary mt-0.5 text-[10px]"></i> {b}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mb-8">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-star"></i> FITUR UNGGULAN
              </h4>
              <ul class="space-y-2">
                {project.coolFeatures.map((c) => (
                  <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-circle-check text-primary mt-0.5 text-[10px]"></i> {c}
                  </li>
                ))}
              </ul>
            </div>

            {project.team && project.team.length > 0 && (
              <div class="mb-8">
                <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                  <i class="fa-solid fa-users"></i> TIM PENGEMBANG
                </h4>
                <div class="flex flex-wrap gap-3">
                  {project.team.map((name) => {
                    const person = findPerson(name);
                    return (
                      <div class="flex items-center gap-2 bg-gray-50 dark:bg-white/5 rounded-full pl-1 pr-4 py-1">
                        {person?.photo ? (
                          <img src={person.photo} alt={name} class="w-7 h-7 rounded-full object-cover">
                        ) : (
                          <div class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[9px] font-bold">{person?.initials ?? name.charAt(0)}</div>
                        )}
                        <span class="text-xs font-semibold text-gray-700 dark:text-gray-200">{name}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {project.link ? (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="bg-primary hover:bg-blue-700 text-white px-6 py-3 rounded-full text-xs font-semibold inline-flex items-center gap-2 transition">
                Kunjungi Situs <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              </a>
            ) : (
              <span class="text-gray-400 text-xs font-semibold inline-flex items-center gap-2 border border-gray-200 dark:border-white/10 px-6 py-3 rounded-full">
                <i class="fa-solid fa-lock text-[10px]"></i> Belum Ada Tautan Publik
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      // ---- Search & filter ----
      const searchInput = document.getElementById('portfolio-search');
      const statusSelect = document.getElementById('portfolio-status');
      const kindButtons = Array.from(document.querySelectorAll('.filter-kind-btn'));
      const groupSections = Array.from(document.querySelectorAll('.portfolio-group'));
      const resultCount = document.getElementById('portfolio-result-count');
      const emptyState = document.getElementById('portfolio-empty-state');

      let activeKind = 'all';

      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        const activeStatus = statusSelect?.value || 'all';
        let totalVisible = 0;

        groupSections.forEach((section) => {
          const sectionKind = section.dataset.kind;
          let visibleInGroup = 0;

          if (activeKind === 'all' || activeKind === sectionKind) {
            section.querySelectorAll('.portfolio-card').forEach((card) => {
              const matchesStatus = activeStatus === 'all' || card.dataset.status === activeStatus;
              const matchesQuery = !query || (card.dataset.search || '').includes(query);
              const visible = matchesStatus && matchesQuery;
              card.style.display = visible ? '' : 'none';
              if (visible) visibleInGroup++;
            });
          } else {
            section.querySelectorAll('.portfolio-card').forEach((card) => {
              card.style.display = 'none';
            });
          }

          section.style.display = visibleInGroup > 0 ? '' : 'none';
          totalVisible += visibleInGroup;
        });

        if (resultCount) {
          resultCount.textContent = `Showing ${totalVisible} project${totalVisible === 1 ? '' : 's'}`;
        }
        emptyState?.classList.toggle('hidden', totalVisible > 0);
      }

      kindButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeKind = btn.dataset.kind || 'all';
          kindButtons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
          applyFilters();
        });
      });

      searchInput?.addEventListener('input', applyFilters);
      statusSelect?.addEventListener('change', applyFilters);

      applyFilters();

      // ---- Project detail modal ----
      const overlay = document.getElementById('project-modal-overlay');
      const panels = Array.from(document.querySelectorAll('.project-modal-panel'));

      function openModal(id) {
        panels.forEach((p) => p.classList.toggle('hidden', p.id !== `modal-${id}`));
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-modal-target]').forEach((btn) => {
        btn.addEventListener('click', () => openModal(btn.dataset.modalTarget));
      });

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
      });
      document.querySelectorAll('.modal-close-btn').forEach((btn) => btn.addEventListener('click', closeModal));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    })();
  </script>

  <!-- ================= BOTTOM CTA ================= -->
  <section class="py-16 px-8">
    <div class="max-w-7xl mx-auto cta-bg rounded-3xl p-12 flex flex-col md:flex-row justify-between items-center relative overflow-hidden shadow-2xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary rounded-full filter blur-[100px] opacity-20"></div>

      <div class="z-10 mb-8 md:mb-0 max-w-2xl">
        <div class="text-xs font-bold text-primary tracking-widest mb-2">MARI BERKOLABORASI</div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-tight mb-4">
          Punya Ide Proyek?<br>Wujudkan Bersama SYNVORA
        </h2>
        <p class="text-sm text-gray-300">
          Diskusikan kebutuhan Anda dan temukan solusi terbaik untuk organisasi Anda.
        </p>
      </div>

