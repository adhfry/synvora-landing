---
import Layout from '../layouts/Layout.astro';
import { portfolioProjects, getAllPortfolioCategories, upcomingCategories } from '../data/portfolioProjects';
import { teamMembers, founder } from '../data/team';

const categories = getAllPortfolioCategories();
const allPeople = [founder, ...teamMembers];
function findPerson(name: string) {
  return allPeople.find((p) => p.name === name);
}
---

<Layout
  title="Portofolio - SYNVORA Teknologi Indonesia"
  description="Jelajahi portofolio proyek SYNVORA Teknologi Indonesia di sektor kesehatan, pemerintahan, pendidikan, dan perusahaan, dari sistem informasi hingga aplikasi mobile."
  navVariant="light"
  footerVariant="default"
  active="portfolio"
  bodyClass="bg-white"
>
  <Fragment slot="head">
    <style is:global>
      .hero-bg {
        background-color: #0a1128;
        /* Placeholder image: Menyesuaikan dengan gambar kantor/meja kerja */
        background-image: linear-gradient(to right, rgba(10, 17, 40, 0.95) 0%, rgba(10, 17, 40, 0.8) 40%, rgba(10, 17, 40, 0.4) 100%),
          url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .filter-btn {
        transition: all 0.2s ease;
      }
      .filter-btn.active {
        background-color: #0066ff;
        color: white;
        border-color: #0066ff;
      }
      .filter-btn:not(.active):hover {
        border-color: #0066ff;
        color: #0066ff;
      }
      .card-shadow {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #f3f4f6;
      }
      .stat-bg {
        background-color: #f0f7ff;
        border: 1px solid #e0efff;
      }
      .cta-bg {
        background-color: #0a1128;
        background-image: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.85)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .case-study-stat {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
        flex: 1;
      }
      .dark .card-shadow {
        border-color: rgba(255, 255, 255, 0.08);
      }
      .dark .stat-bg {
        background-color: rgba(0, 102, 255, 0.08);
        border-color: rgba(0, 102, 255, 0.2);
      }
      .dark .case-study-stat {
        background-color: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-bg text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div>
        <!-- Breadcrumb -->
        <div class="text-xs font-semibold text-gray-400 mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-white cursor-pointer">Beranda</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-white">Portfolio</span>
        </div>

        <!-- Title -->
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
          Portofolio <span class="text-primary">Kami</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-gray-300 text-sm md:text-base mb-10 max-w-lg leading-relaxed">
          Berbagai solusi digital yang telah kami kembangkan untuk membantu organisasi bekerja lebih efektif, efisien, dan berdampak nyata.
        </p>

        <!-- Tagline -->
        <div class="border-l-4 border-primary pl-4">
          <div class="text-xs font-bold tracking-[0.2em] text-white mb-2">
            SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
          </div>
          <div class="text-xs text-gray-400">
            A Better Tomorrow Through Technology
          </div>
        </div>
      </div>

      <!-- Right Floating Card -->
      <div class="hidden lg:flex justify-end relative">
        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl max-w-sm relative z-20">
          <div class="text-3xl font-extrabold text-white leading-tight mb-4">
            Great<br>Solutions<br>Create<br>Greater<br>Impact
          </div>
          <div class="w-12 h-1 bg-primary mb-6"></div>

          <!-- Inner Card -->
          <div class="bg-[#0A1128]/80 p-4 rounded-xl border border-white/10 flex items-start gap-3">
            <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0">
              <i class="fa-solid fa-lightbulb text-white"></i>
            </div>
            <div>
              <div class="text-xs font-bold text-white mb-1">Dari Ide Menjadi Solusi Nyata</div>
              <div class="text-[10px] text-gray-400 leading-tight">Setiap proyek adalah langkah menuju masa depan yang lebih baik.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PORTFOLIO SECTION ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Header Row -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12">
        <div class="max-w-2xl">
          <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary rounded-full"></span> KARYA NYATA
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-4">
            Proyek yang Memberikan Dampak
          </h2>
          <p class="text-sm text-gray-500 max-w-xl">
            Kami bangga dapat berkolaborasi dengan berbagai instansi dan organisasi dalam menghadirkan solusi teknologi yang relevan dan berkualitas.
          </p>
        </div>
        <!-- Quote -->
        <div class="mt-6 md:mt-0 max-w-sm relative pl-6 border-l-2 border-primary">
          <i class="fa-solid fa-quote-left text-2xl text-blue-100 absolute -top-2 left-2"></i>
          <p class="text-xs text-gray-500 italic relative z-10 mb-2">"Kepercayaan klien adalah bukti komitmen kami untuk selalu memberikan yang terbaik."</p>
          <div class="text-[10px] font-bold tracking-widest text-primary">SYNVORA TEKNOLOGI INDONESIA</div>
        </div>
      </div>

      <!-- Filter & Search Row -->
      <div class="flex flex-col lg:flex-row justify-between items-center gap-4 mb-10">
        <!-- Filters -->
        <div id="portfolio-filters" class="flex flex-wrap gap-2 w-full lg:w-auto">
          <button type="button" data-filter="Semua" class="filter-btn active bg-primary text-white px-5 py-2 rounded-full text-xs font-semibold border border-primary">Semua</button>
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              data-upcoming={upcomingCategories.includes(cat) ? 'true' : 'false'}
              class="filter-btn bg-white text-gray-600 px-5 py-2 rounded-full text-xs font-semibold border border-gray-200 inline-flex items-center gap-1.5"
            >
              {cat}
              {upcomingCategories.includes(cat) && <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>}
            </button>
          ))}
        </div>

        <!-- Search -->
        <div class="flex gap-3 w-full lg:w-auto">
          <div class="relative flex-1 lg:flex-none lg:w-64">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input id="portfolio-search" type="text" placeholder="Cari proyek..." class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-full text-xs focus:outline-none focus:border-primary">
          </div>
        </div>
      </div>

      <!-- Projects Grid -->
      <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolioProjects.map((project) => (
          <div
            class="portfolio-card bg-white rounded-2xl card-shadow overflow-hidden flex flex-col group"
            data-categories={project.categories.join('|')}
            data-search={`${project.title} ${project.shortDescription} ${project.categories.join(' ')}`.toLowerCase()}
          >
            <div class="h-44 relative overflow-hidden">
              <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500">
              <div class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
                {project.categories.map((cat) => (
                  <span class="bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800 shadow-sm">{cat}</span>
                ))}
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-bold text-gray-900 text-sm mb-2">{project.title}</h3>
              <p class="text-[11px] text-gray-500 mb-4 flex-1 leading-relaxed">{project.shortDescription}</p>
              <div class="flex items-center justify-between gap-3">
                <button type="button" data-modal-target={project.id} class="text-primary text-xs font-semibold flex items-center gap-2 group-hover:gap-3 transition-all">
                  Baca Selengkapnya <i class="fa-solid fa-arrow-right"></i>
                </button>
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary transition" aria-label="Kunjungi situs">
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                  </a>
                ) : (
                  <span class="text-gray-400 text-[10px] font-semibold flex items-center gap-1.5" title="Studi Kasus Privat"><i class="fa-solid fa-lock"></i></span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <p id="portfolio-no-results" class="hidden text-center text-sm text-gray-500 py-12">
        Tidak ada proyek yang cocok dengan pencarian atau kategori ini.
      </p>

      <!-- Coming Soon panel - shown when a category filter has no case studies yet -->
      <div id="portfolio-coming-soon" class="hidden">
        <div class="bg-gradient-to-r from-[#F0F7FF] to-[#E0EFFF] rounded-3xl p-10 md:p-14 text-center max-w-2xl mx-auto">
          <div class="inline-flex items-center gap-2 bg-white text-primary text-[10px] font-bold tracking-widest px-4 py-1.5 rounded-full mb-6 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> SEGERA HADIR
          </div>
          <h3 class="text-2xl font-extrabold text-gray-900 mb-4">
            Proyek <span id="coming-soon-category" class="text-primary">Kategori Ini</span> Sedang Kami Siapkan
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-8 max-w-lg mx-auto">
            Studi kasus publik untuk kategori ini belum tersedia, tapi bukan berarti kami belum siap. Ceritakan ide atau kebutuhan Anda kepada kami — siapa tahu proyek Anda yang tampil di sini berikutnya.
          </p>
          <a href="/konsultasi-gratis" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold inline-flex items-center gap-2 transition">
            Ceritakan Ide Anda <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PROJECT DETAIL MODAL ================= -->
  <div id="project-modal-overlay" class="hidden fixed inset-0 bg-black/60 z-[100] items-center justify-center p-4">
    <div class="bg-white dark:bg-[#0f1a3d] rounded-2xl max-w-2xl w-full max-h-[85vh] overflow-y-auto relative shadow-2xl">
      <button type="button" class="modal-close-btn absolute top-4 right-4 w-9 h-9 rounded-full bg-white/90 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-gray-100 dark:hover:bg-white/20 transition z-10" aria-label="Tutup">
        <i class="fa-solid fa-xmark"></i>
      </button>
      {portfolioProjects.map((project) => (
        <div class="project-modal-panel hidden" id={`modal-${project.id}`}>
          <div class="h-56 relative overflow-hidden rounded-t-2xl">
            <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top">
            <div class="absolute bottom-3 left-6 flex flex-wrap gap-1.5">
              {project.categories.map((cat) => (
                <span class="bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800 shadow-sm">{cat}</span>
              ))}
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-xl font-extrabold text-gray-900 dark:text-white mb-3">{project.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">{project.overview}</p>

            <div class="mb-6">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-list-check"></i> FITUR UTAMA
              </h4>
              <ul class="space-y-2">
                {project.features.map((f) => (
                  <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-circle-check text-primary mt-0.5 text-[10px]"></i> {f}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mb-6">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-thumbs-up"></i> KELEBIHAN
              </h4>
              <ul class="space-y-2">
                {project.benefits.map((b) => (
                  <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-circle-check text-primary mt-0.5 text-[10px]"></i> {b}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mb-8">
              <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-star"></i> FITUR UNGGULAN
              </h4>
              <ul class="space-y-2">
                {project.coolFeatures.map((c) => (
                  <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-circle-check text-primary mt-0.5 text-[10px]"></i> {c}
                  </li>
                ))}
              </ul>
            </div>

            {project.team && project.team.length > 0 && (
              <div class="mb-8">
                <h4 class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
                  <i class="fa-solid fa-users"></i> TIM PENGEMBANG
                </h4>
                <div class="flex flex-wrap gap-3">
                  {project.team.map((name) => {
                    const person = findPerson(name);
                    return (
                      <div class="flex items-center gap-2 bg-gray-50 dark:bg-white/5 rounded-full pl-1 pr-4 py-1">
                        {person?.photo ? (
                          <img src={person.photo} alt={name} class="w-7 h-7 rounded-full object-cover">
                        ) : (
                          <div class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[9px] font-bold">{person?.initials ?? name.charAt(0)}</div>
                        )}
                        <span class="text-xs font-semibold text-gray-700 dark:text-gray-200">{name}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {project.link ? (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="bg-primary hover:bg-blue-700 text-white px-6 py-3 rounded-full text-xs font-semibold inline-flex items-center gap-2 transition">
                Kunjungi Situs <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              </a>
            ) : (
              <span class="text-gray-400 text-xs font-semibold inline-flex items-center gap-2 border border-gray-200 dark:border-white/10 px-6 py-3 rounded-full">
                <i class="fa-solid fa-lock text-[10px]"></i> Studi Kasus Privat
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      // ---- Filter & search ----
      const filterButtons = document.querySelectorAll('#portfolio-filters .filter-btn');
      const searchInput = document.getElementById('portfolio-search');
      const cards = Array.from(document.querySelectorAll('.portfolio-card'));
      const noResults = document.getElementById('portfolio-no-results');
      const comingSoon = document.getElementById('portfolio-coming-soon');
      const comingSoonCategory = document.getElementById('coming-soon-category');
      let activeCategory = 'Semua';

      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCategories = card.dataset.categories ? card.dataset.categories.split('|') : [];
          const matchesCategory = activeCategory === 'Semua' || cardCategories.includes(activeCategory);
          const matchesSearch = !query || card.dataset.search.includes(query);
          const visible = matchesCategory && matchesSearch;
          card.style.display = visible ? '' : 'none';
          if (visible) visibleCount++;
        });

        if (visibleCount === 0 && !query && activeCategory !== 'Semua') {
          // Category has no case studies at all (not a search miss) - invite instead of a dead end.
          if (comingSoonCategory) comingSoonCategory.textContent = activeCategory;
          comingSoon?.classList.remove('hidden');
          noResults?.classList.add('hidden');
        } else {
          comingSoon?.classList.add('hidden');
          noResults?.classList.toggle('hidden', visibleCount > 0);
        }
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeCategory = btn.dataset.filter || 'Semua';
          applyFilters();
        });
      });

      searchInput?.addEventListener('input', applyFilters);

      // ---- Project detail modal ----
      const overlay = document.getElementById('project-modal-overlay');
      const panels = Array.from(document.querySelectorAll('.project-modal-panel'));

      function openModal(id) {
        panels.forEach((p) => p.classList.toggle('hidden', p.id !== `modal-${id}`));
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-modal-target]').forEach((btn) => {
        btn.addEventListener('click', () => openModal(btn.dataset.modalTarget));
      });

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
      });
      document.querySelectorAll('.modal-close-btn').forEach((btn) => btn.addEventListener('click', closeModal));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    })();
  </script>

  <!-- ================= STATS SECTION ================= -->
  <section class="py-16 px-8">
    <div class="max-w-7xl mx-auto stat-bg rounded-2xl p-10 flex flex-col lg:flex-row justify-between items-center">
      <!-- Title -->
      <div class="w-full lg:w-1/4 mb-8 lg:mb-0">
        <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span> DALAM ANGKA
        </div>
        <h3 class="text-2xl font-extrabold text-gray-900 leading-tight">Hasil yang<br>Berbicara</h3>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 w-full lg:w-3/4 text-center">
        <div class="flex flex-col items-center">
          <i class="fa-solid fa-cube text-2xl text-primary mb-3"></i>
          <div class="text-3xl font-extrabold text-gray-900 mb-1">50+</div>
          <div class="text-xs text-gray-500">Proyek Diselesaikan</div>
        </div>
        <div class="flex flex-col items-center">
          <i class="fa-regular fa-handshake text-2xl text-primary mb-3"></i>
          <div class="text-3xl font-extrabold text-gray-900 mb-1">30+</div>
          <div class="text-xs text-gray-500">Klien Terpercaya</div>
        </div>
        <div class="flex flex-col items-center">
          <i class="fa-regular fa-star text-2xl text-primary mb-3"></i>
          <div class="text-3xl font-extrabold text-gray-900 mb-1">5+</div>
          <div class="text-xs text-gray-500">Tahun Pengalaman</div>
        </div>
        <div class="flex flex-col items-center">
          <i class="fa-solid fa-users text-2xl text-primary mb-3"></i>
          <div class="text-3xl font-extrabold text-gray-900 mb-1">100%</div>
          <div class="text-xs text-gray-500">Komitmen pada Kualitas</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CASE STUDY SECTION ================= -->
  <section class="py-16 bg-white px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <!-- Ganti dengan gambar dashboard/laptop -->
          <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800" alt="Case Study Dashboard" class="w-full h-[400px] object-cover">
        </div>
        <!-- Play Button Overlay -->
        <div class="absolute bottom-6 left-6 bg-primary text-white px-5 py-2.5 rounded-full text-xs font-semibold flex items-center gap-2 shadow-lg cursor-pointer hover:bg-blue-700 transition">
          <i class="fa-solid fa-play"></i> Lihat Demo
        </div>
        <!-- Phone Mockup Overlay (Simplified) -->
        <div class="hidden sm:block absolute bottom-0 right-10 w-32 h-64 bg-white rounded-t-xl shadow-2xl border-4 border-gray-800 overflow-hidden">
          <div class="h-full bg-gray-50 p-2 flex flex-col gap-2">
            <div class="h-4 bg-gray-200 rounded w-1/2 mx-auto"></div>
            <div class="h-20 bg-blue-100 rounded"></div>
            <div class="h-4 bg-gray-200 rounded w-3/4"></div>
            <div class="h-4 bg-gray-200 rounded w-1/2"></div>
            <div class="h-10 bg-blue-100 rounded mt-auto"></div>
          </div>
        </div>
      </div>

      <!-- Right Content -->
      <div>
        <div class="text-xs font-bold text-primary tracking-widest mb-3 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> STUDI KASUS
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-6">Digitalisasi Laboratorium untuk Pelayanan yang Lebih Cepat</h2>
        <p class="text-sm text-gray-500 leading-relaxed mb-8">
          Implementasi sistem informasi laboratorium yang berhasil meningkatkan efisiensi kerja hingga 70% dan mempercepat waktu pelayanan hasil pemeriksaan.
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <div class="case-study-stat">
            <div class="text-xl font-extrabold text-primary mb-1">70%</div>
            <div class="text-[10px] text-gray-500">Peningkatan Efisiensi</div>
          </div>
          <div class="case-study-stat">
            <div class="text-xl font-extrabold text-primary mb-1">50%</div>
            <div class="text-[10px] text-gray-500">Pengurangan Waktu Pelayanan</div>
          </div>
          <div class="case-study-stat">
