---
import Layout from '../layouts/Layout.astro';
import { blogPosts, getCategories, getTopics } from '../data/blogPosts';
import { SITE } from '../lib/site';

// Featured article is pinned by slug (not just "newest") so it stays put
// even as newer posts get added ahead of it in the array.
const featured = blogPosts.find((p) => p.slug === 'bbm-belajar-bahasa-madura-inovasi-synvora')!;
// The featured post is also kept in "Artikel Terbaru", it deserves the
// extra visibility of showing up in both places, not just the hero slot.
const rest = blogPosts;
const categories = getCategories();
const topics = getTopics();

const EXCERPT_MAX = 100;
function truncate(text: string, max: number): string {
  if (text.length <= max) return text;
  return `${text.slice(0, max).trimEnd()}...`;
}
---

<Layout
  title="Blog & Insight - SYNVORA Teknologi Indonesia"
  description="Artikel, berita, dan wawasan seputar teknologi, transformasi digital, sistem informasi, dan tips seputar pengembangan aplikasi dari tim SYNVORA Teknologi Indonesia."
  navVariant="light"
  footerVariant="default"
  active="blog"
  bodyClass="bg-[#F8FAFC] dark:bg-synvora-dark"
>
  <Fragment slot="head">
    <style is:global>
      .hero-bg {
        background-color: #0a1128;
        background-image: linear-gradient(to right, rgba(10, 17, 40, 0.95) 0%, rgba(10, 17, 40, 0.85) 50%, rgba(10, 17, 40, 0.4) 100%),
          url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .filter-btn {
        transition: all 0.2s ease;
        white-space: nowrap;
      }
      .filter-btn.active {
        background-color: #0066ff;
        color: white;
        border-color: #0066ff;
      }
      .filter-btn:not(.active):hover {
        border-color: #0066ff;
        color: #0066ff;
      }
      .page-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 10px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: white;
        color: #4b5563;
        font-size: 11px;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
      }
      .page-btn:hover:not(.disabled) {
        border-color: #0066ff;
        color: #0066ff;
      }
      .page-btn.active {
        background-color: #0066ff;
        color: white;
        border-color: #0066ff;
      }
      .page-btn.disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .dark .page-btn {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.12);
        color: #9ca3af;
      }
      .card-shadow {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        border: 1px solid #f3f4f6;
        background: white;
      }
      .sidebar-card {
        background: white;
        border: 1px solid #f3f4f6;
        border-radius: 16px;
        padding: 24px;
      }
      .cta-bg {
        background-color: #0a1128;
        background-image: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.85)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .hero-mockup-laptop {
        width: 100%;
        height: 200px;
        background: #0d1b3e;
        border: 2px solid #1e3a8a;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      }
      .hero-mockup-screen {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #0d1b3e 0%, #1e3a8a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 14px;
        font-weight: bold;
        text-align: center;
        line-height: 1.5;
      }
      .hero-mockup-card {
        position: absolute;
        right: -20px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 8px 16px;
        border-radius: 8px;
        color: white;
        font-size: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .dark .card-shadow {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.08);
      }
      .dark .sidebar-card {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.08);
      }
      .dark .filter-btn:not(.active) {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.12);
        color: #9ca3af;
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-bg text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div>
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
          Insight &amp; Cerita<br>dari <span class="text-primary">SYNVORA</span>
        </h1>
        <p class="text-gray-300 text-sm md:text-base mb-10 max-w-lg leading-relaxed">
          Artikel, berita, dan wawasan seputar teknologi, inovasi digital, dan transformasi organisasi untuk masa depan yang lebih baik.
        </p>
        <div class="border-l-4 border-primary pl-4">
          <div class="text-xs font-bold tracking-[0.2em] text-white mb-2">
            SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
          </div>
          <div class="text-xs text-gray-400">
            A Better Tomorrow Through Technology
          </div>
        </div>
      </div>

      <!-- Right Mockup -->
      <div class="hidden lg:flex justify-end relative items-center">
        <div class="relative w-80">
          <div class="hero-mockup-laptop">
            <div class="hero-mockup-screen">
              Ideas<br>Insights<br>Impact
            </div>
          </div>
          <div class="absolute top-10 -left-12 flex flex-col gap-2">
            <div class="hero-mockup-card" style="top: 0; right: 0;"><i class="fa-solid fa-microchip text-primary"></i> Technology</div>
            <div class="hero-mockup-card" style="top: 30px; right: 0;"><i class="fa-solid fa-arrows-spin text-primary"></i> Innovation</div>
            <div class="hero-mockup-card" style="top: 60px; right: 0;"><i class="fa-solid fa-users text-primary"></i> People</div>
            <div class="hero-mockup-card" style="top: 90px; right: 0;"><i class="fa-solid fa-arrow-right text-primary"></i> A Better Tomorrow</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MAIN CONTENT SECTION ================= -->
  <section class="py-16 px-8 -mt-16 relative z-20">
    <div class="max-w-7xl mx-auto">
      <!-- Filter & Search Row -->
      <div class="flex flex-col lg:flex-row justify-between items-center gap-4 mb-10 bg-white dark:bg-[#0f1a3d] p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-white/10">
        <div id="category-filters" class="flex flex-wrap gap-2 w-full lg:w-auto">
          <button type="button" data-filter="Semua" class="filter-btn active bg-primary text-white px-5 py-2 rounded-full text-xs font-semibold border border-primary">Semua</button>
          {categories.map((cat) => (
            <button type="button" data-filter={cat} class="filter-btn bg-white text-gray-600 px-5 py-2 rounded-full text-xs font-semibold border border-gray-200">{cat}</button>
          ))}
        </div>
        <div class="relative w-full lg:w-72">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input id="article-search" type="text" placeholder="Cari artikel..." class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-white/10 dark:bg-transparent rounded-full text-xs focus:outline-none focus:border-primary">
        </div>
      </div>

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- LEFT COLUMN (Featured + Articles) -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Featured Post -->
          <a
            href={`/blog/${featured.slug}`}
            data-category={featured.category}
            data-search={`${featured.title} ${featured.excerpt}`.toLowerCase()}
            class="featured-card bg-white rounded-2xl card-shadow overflow-hidden flex flex-col md:flex-row block"
          >
            <div class="md:w-1/2 relative">
              <img src={featured.image} alt={featured.title} class="w-full h-full object-cover min-h-[250px]">
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800 shadow-sm">{featured.category}</div>
            </div>
            <div class="md:w-1/2 p-8 flex flex-col justify-center">
              <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> ARTIKEL PILIHAN
              </div>
              <h2 class="text-2xl font-extrabold text-gray-900 dark:text-white leading-tight mb-4">{featured.title}</h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-6">{featured.excerpt}</p>
              <div class="flex items-center justify-between border-t border-gray-100 dark:border-white/10 pt-4">
                <div class="flex items-center gap-3">
                  {featured.authorImage ? (
                    <img src={featured.authorImage} alt={featured.author} class="w-8 h-8 rounded-full object-cover">
                  ) : (
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-[10px] font-bold">{featured.author.charAt(0)}</div>
                  )}
                  <div>
                    <div class="text-[10px] font-bold text-gray-900 dark:text-white">{featured.author}</div>
                    <div class="text-[9px] text-gray-500 dark:text-gray-400">CEO &amp; Founder</div>
                  </div>
                </div>
                <div class="text-[9px] text-gray-400 text-right">
                  <div>{featured.publishedDisplay}</div>
                  <div>{featured.readTime}</div>
                </div>
                <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center hover:bg-blue-700 transition shrink-0">
                  <i class="fa-solid fa-arrow-right text-xs"></i>
                </span>
              </div>
            </div>
          </a>

          <!-- Artikel Terbaru Header -->
          <div class="flex justify-between items-center">
            <h3 class="text-xl font-extrabold text-gray-900 dark:text-white">Artikel Terbaru</h3>
            <div class="relative">
              <select id="sort-select" class="appearance-none bg-white dark:bg-[#0f1a3d] dark:border-white/10 border border-gray-200 rounded-lg px-4 py-2 text-xs font-semibold text-gray-600 dark:text-gray-300 focus:outline-none focus:border-primary pr-8 cursor-pointer">
                <option value="terbaru">Urutkan: Terbaru</option>
                <option value="terlama">Urutkan: Terlama</option>
                <option value="populer">Urutkan: Populer</option>
              </select>
              <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-[10px] pointer-events-none"></i>
            </div>
          </div>

          <!-- Articles Grid -->
          <div id="article-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
            {rest.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                data-category={post.category}
                data-search={`${post.title} ${post.excerpt}`.toLowerCase()}
                data-slug={post.slug}
                data-published={post.publishedAt}
                class="article-card bg-white rounded-2xl card-shadow overflow-hidden flex flex-col group block"
              >
                <div class="h-44 relative overflow-hidden">
                  <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                  <div class="absolute top-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800 shadow-sm">{post.category}</div>
                </div>
                <div class="p-5 flex-1 flex flex-col">
                  <div class="text-[10px] text-gray-400 mb-2">{post.publishedDisplay}</div>
                  <h3 class="font-bold text-gray-900 dark:text-white text-sm mb-2 leading-tight">{post.title}</h3>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400 mb-4 flex-1 leading-relaxed">{truncate(post.excerpt, EXCERPT_MAX)}</p>
                  <div class="flex items-center justify-between border-t border-gray-100 dark:border-white/10 pt-3">
                    <div class="flex items-center gap-2">
                      {post.authorImage ? (
                        <img src={post.authorImage} alt={post.author} class="w-6 h-6 rounded-full object-cover">
                      ) : (
                        <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white text-[8px] font-bold">{post.author.charAt(0)}</div>
                      )}
                      <div class="text-[9px] font-semibold text-gray-700 dark:text-gray-300">{post.author}</div>
                    </div>
                    <div class="text-[9px] text-gray-400 flex items-center gap-1"><i class="fa-regular fa-clock"></i> {post.readTime}</div>
                    <i class="fa-solid fa-arrow-right text-primary text-[10px]"></i>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <p id="no-results" class="hidden text-center text-sm text-gray-500 dark:text-gray-400 py-12">
            Tidak ada artikel yang cocok dengan pencarian atau kategori ini.
          </p>

          <div id="pagination" class="flex items-center justify-center flex-wrap gap-2 pt-2"></div>
        </div>

        <!-- RIGHT COLUMN (SIDEBAR) -->
        <div class="lg:col-span-1 space-y-8">

          <!-- Topik Populer -->
          <div class="sidebar-card">
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-bold text-gray-900 dark:text-white text-base">Topik Populer</h3>
              <a href="/blog/topik-populer" class="text-primary text-[10px] font-semibold hover:underline">Lihat Semua <i class="fa-solid fa-arrow-right text-[8px]"></i></a>
            </div>
            <ul class="space-y-2">
              {topics.map((topic) => (
                <li>
                  <a href={`/blog/topik-populer#${topic.slug}`} class="flex items-center justify-between text-xs p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-white/5 transition cursor-pointer">
                    <div class="flex items-center gap-2">
                      <i class={`${topic.icon} text-gray-400 w-4`}></i> {topic.name}
                    </div>
                    <span class="bg-gray-100 dark:bg-white/10 text-gray-500 dark:text-gray-400 px-2 py-0.5 rounded-full text-[10px]">{topic.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Newsletter -->
          <div class="bg-[#0A1128] rounded-2xl p-6 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary rounded-full filter blur-[50px] opacity-20"></div>
            <div class="relative z-10">
              <div class="text-[10px] font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
                <span class="w-2 h-2 bg-primary rounded-full"></span> BERLANGGANAN
              </div>
              <h3 class="font-bold text-lg leading-tight mb-3">Dapatkan Insight Terbaru dari SYNVORA</h3>
              <p class="text-[11px] text-gray-300 mb-6 leading-relaxed">Berlangganan newsletter kami untuk mendapatkan artikel, berita, dan wawasan teknologi langsung ke email Anda.</p>
              <div class="relative mb-3">
                <input type="email" placeholder="Masukkan email Anda" class="w-full pl-4 pr-4 py-3 border border-white/20 bg-white/10 rounded-xl text-xs text-white placeholder-gray-400 focus:outline-none focus:border-primary">
              </div>
              <button class="w-full bg-primary hover:bg-blue-700 text-white py-3 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition">
                Berlangganan <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </button>
              <div class="flex items-center gap-2 mt-4 text-[9px] text-gray-400">
                <i class="fa-solid fa-lock"></i> Kami tidak akan membagikan email Anda kepada pihak lain.
              </div>
            </div>
          </div>

          <!-- Banner Ad -->
          <div class="relative rounded-2xl overflow-hidden shadow-lg h-64">
            <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=600" alt="Mountain" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A1128] via-[#0A1128]/80 to-transparent flex flex-col justify-end p-6">
              <h3 class="text-xl font-extrabold text-white leading-tight mb-4">Dari Ide<br>Menuju Solusi<br>yang Berdampak</h3>
              <a href="/tentang-kami" class="bg-white text-gray-900 hover:bg-gray-100 px-5 py-2.5 rounded-full text-xs font-semibold inline-flex items-center gap-2 transition self-start">
                Tentang Kami <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </div>

          <!-- Ikuti Kami -->
          <div class="sidebar-card">
            <h3 class="font-bold text-gray-900 dark:text-white text-base mb-1">Ikuti Kami</h3>
            <p class="text-[11px] text-gray-500 dark:text-gray-400 mb-5 leading-relaxed">Pantau kabar terbaru dan cerita di balik layar SYNVORA lewat media sosial kami.</p>
            <div class="flex items-center gap-3">
              <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn SYNVORA" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-primary hover:text-white transition">
                <i class="fa-brands fa-linkedin-in"></i>
              </a>
              <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram SYNVORA" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-primary hover:text-white transition">
                <i class="fa-brands fa-instagram"></i>
              </a>
              <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub SYNVORA" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-primary hover:text-white transition">
                <i class="fa-brands fa-github"></i>
              </a>
              <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp SYNVORA" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 flex items-center justify-center hover:bg-primary hover:text-white transition">
                <i class="fa-brands fa-whatsapp"></i>
              </a>
            </div>
          </div>

          <!-- Lokasi Kami -->
          <div class="sidebar-card !p-0 overflow-hidden">
            <div class="p-6 pb-4">
              <h3 class="font-bold text-gray-900 dark:text-white text-base mb-1">Lokasi Kami</h3>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed">{SITE.addressShort}</p>
            </div>
            <div class="h-40 w-full">
              <iframe
                src={SITE.mapsEmbedUrl}
                class="w-full h-full border-0"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                title="Lokasi PT Synvora Teknologi Indonesia"
              ></iframe>
            </div>
            <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-primary text-[11px] font-semibold py-3 hover:bg-gray-50 dark:hover:bg-white/5 transition">
              Buka di Google Maps <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ================= BOTTOM CTA ================= -->
  <section class="py-16 px-8">
    <div class="max-w-7xl mx-auto cta-bg rounded-3xl p-12 flex flex-col md:flex-row justify-between items-center relative overflow-hidden shadow-2xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary rounded-full filter blur-[100px] opacity-20"></div>
      <div class="z-10 mb-8 md:mb-0 max-w-2xl">
        <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span> MARI BERKOLABORASI
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-tight mb-4">
          Wujudkan Solusi Teknologi<br>untuk Masa Depan yang Lebih Baik.
        </h2>
        <p class="text-sm text-gray-300">
          Kami siap menjadi mitra Anda dalam menghadirkan solusi digital yang berdampak nyata bagi organisasi dan masyarakat.
        </p>
      </div>
      <div class="flex gap-4 z-10">
        <a href="/hubungi-kami" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold flex items-center gap-2 transition">
          Hubungi Kami <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const PAGE_SIZE = 6;
      const filterButtons = document.querySelectorAll('#category-filters .filter-btn');
      const searchInput = document.getElementById('article-search');
      const sortSelect = document.getElementById('sort-select');
      const articleGrid = document.getElementById('article-grid');
      const featuredCard = document.querySelector('.featured-card');
      const noResults = document.getElementById('no-results');
      const pagination = document.getElementById('pagination');
      let activeCategory = 'Semua';
      let currentPage = 1;

      function matchesFilters(el, query) {
        const matchesCategory = activeCategory === 'Semua' || el.dataset.category === activeCategory;
        const matchesSearch = !query || el.dataset.search.includes(query);
        return matchesCategory && matchesSearch;
      }

      function renderPagination(totalPages) {
        if (!pagination) return;
        pagination.innerHTML = '';
        if (totalPages <= 1) return;

        function makeBtn(label, page, disabled, active) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = label;
          btn.className = 'page-btn' + (active ? ' active' : '') + (disabled ? ' disabled' : '');
          if (disabled) {
            btn.disabled = true;
          } else {
            btn.addEventListener('click', () => {
              currentPage = page;
              updateGrid();
            });
          }
          return btn;
        }

        pagination.appendChild(makeBtn('Sebelumnya', currentPage - 1, currentPage === 1, false));
        for (let i = 1; i <= totalPages; i++) {
          pagination.appendChild(makeBtn(String(i), i, false, i === currentPage));
        }
        pagination.appendChild(makeBtn('Berikutnya', currentPage + 1, currentPage === totalPages, false));
      }

      function updateGrid() {
        const query = (searchInput?.value || '').trim().toLowerCase();

        let featuredVisible = false;
        if (featuredCard) {
          featuredVisible = matchesFilters(featuredCard, query);
          featuredCard.style.display = featuredVisible ? '' : 'none';
        }

        const allCards = Array.from(articleGrid.querySelectorAll('.article-card'));
        const matching = allCards.filter((card) => matchesFilters(card, query));
        const totalPages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const start = (currentPage - 1) * PAGE_SIZE;
        const pageSet = new Set(matching.slice(start, start + PAGE_SIZE));

        allCards.forEach((card) => {
          card.style.display = pageSet.has(card) ? '' : 'none';
        });

        if (noResults) {
          noResults.classList.toggle('hidden', matching.length > 0 || featuredVisible);
        }

        renderPagination(totalPages);
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeCategory = btn.dataset.filter || 'Semua';
          currentPage = 1;
          updateGrid();
        });
      });

      searchInput?.addEventListener('input', () => {
        currentPage = 1;
        updateGrid();
      });

      let viewCounts = null;
      async function fetchViewCounts() {
        if (viewCounts) return viewCounts;
        try {
          const res = await fetch('/api/blog-views');
          const data = await res.json();
          viewCounts = data.counts || {};
        } catch {
          viewCounts = {};
        }
        return viewCounts;
      }

      async function sortArticles(mode) {
        if (!articleGrid) return;
        const cards = Array.from(articleGrid.querySelectorAll('.article-card'));

        if (mode === 'populer') {
          const counts = await fetchViewCounts();
          cards.sort((a, b) => (counts[b.dataset.slug] || 0) - (counts[a.dataset.slug] || 0));
        } else if (mode === 'terlama') {
          cards.sort((a, b) => new Date(a.dataset.published).getTime() - new Date(b.dataset.published).getTime());
        } else {
          cards.sort((a, b) => new Date(b.dataset.published).getTime() - new Date(a.dataset.published).getTime());
        }

        cards.forEach((card) => articleGrid.appendChild(card));
        currentPage = 1;
        updateGrid();
      }

      sortSelect?.addEventListener('change', () => sortArticles(sortSelect.value));

      updateGrid();
    })();
  </script>
</Layout>
