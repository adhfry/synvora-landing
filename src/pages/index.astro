---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';
---

<Layout
  title="SYNVORA Teknologi Indonesia"
  description="SYNVORA Teknologi Indonesia adalah mitra terpercaya dalam pengembangan sistem informasi, integrasi sistem, aplikasi web & mobile, hingga konsultasi IT untuk organisasi di seluruh Indonesia."
  navVariant="dark"
  footerVariant="landing"
  active="beranda"
  bodyClass="bg-white"
>
  <Fragment slot="head">
    <style is:global>
      .mockup-container {
        position: relative;
        height: 400px;
        width: 100%;
      }
      .laptop-mockup {
        position: absolute;
        right: 0;
        top: 20px;
        width: 80%;
        height: 300px;
        background: #0d1b3e;
        border: 2px solid #1e3a8a;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        overflow: hidden;
      }
      .laptop-screen {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #0d1b3e 0%, #1e3a8a 100%);
        padding: 20px;
        display: flex;
        flex-direction: column;
      }
      .phone-mockup {
        position: absolute;
        left: 10%;
        bottom: 0;
        width: 120px;
        height: 240px;
        background: #0a1128;
        border: 3px solid #1e3a8a;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
        z-index: 10;
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }
      .floating-badge {
        position: absolute;
        bottom: 20px;
        right: 10px;
        background: white;
        padding: 16px;
        border-radius: 8px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        z-index: 20;
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <HeroSlider />
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div class="z-10">
        <div class="text-xs tracking-[0.2em] font-semibold text-primary mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span> SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
          Teknologi untuk<br />Masa Depan yang<br /><span class="text-primary">Lebih Baik</span>
        </h1>
        <p class="text-gray-400 text-sm md:text-base mb-8 max-w-lg leading-relaxed">
          SYNVORA Teknologi Indonesia adalah mitra terpercaya dalam pembuatan sistem informasi yang inovatif, andal, dan berdampak nyata bagi organisasi Anda.
        </p>
        <div class="flex flex-wrap gap-4 mb-12">
          <a href="/konsultasi-gratis" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold transition flex items-center gap-2">
            Konsultasi Gratis <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
          <a href="/portfolio" class="btn-outline px-8 py-3.5 rounded-full text-sm font-semibold flex items-center gap-2">
            Lihat Portofolio <i class="fa-regular fa-circle-play"></i>
          </a>
        </div>
        <!-- Checkmarks -->
        <div class="flex flex-wrap gap-6 text-xs text-gray-300">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-bolt text-primary"></i> Solusi Terukur
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-user-tie text-primary"></i> Tim Profesional
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-headset text-primary"></i> Dukungan Berkelanjutan
          </div>
        </div>
      </div>

      <!-- Right Mockups -->
      <div class="relative hidden lg:block mockup-container">
        <!-- Laptop -->
        <div class="laptop-mockup">
          <div class="laptop-screen">
            <div class="flex justify-between items-center mb-4">
              <div class="text-[10px] text-gray-400">SYNVORA</div>
              <div class="flex gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
              </div>
            </div>
            <div class="flex-1 flex gap-4">
              <div class="w-1/3 bg-white/5 rounded p-2 flex flex-col gap-2">
                <div class="h-2 bg-white/20 rounded w-3/4"></div>
                <div class="h-2 bg-white/20 rounded w-1/2"></div>
                <div class="h-2 bg-white/20 rounded w-full mt-2"></div>
                <div class="h-2 bg-white/20 rounded w-5/6"></div>
                <div class="h-2 bg-white/20 rounded w-2/3"></div>
              </div>
              <div class="w-2/3 bg-white/5 rounded p-2 flex flex-col justify-between">
                <div class="h-2 bg-white/20 rounded w-1/4"></div>
                <div class="h-12 bg-primary/20 rounded border border-primary/50 flex items-center justify-center">
                  <span class="text-[8px] text-primary">Dashboard Utama</span>
                </div>
                <div class="flex gap-2">
                  <div class="h-8 bg-white/5 rounded flex-1"></div>
                  <div class="h-8 bg-white/5 rounded flex-1"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Phone -->
        <div class="phone-mockup">
          <div class="text-center">
            <div class="text-[8px] text-gray-400 mb-1">SYNVORA</div>
            <div class="text-xs font-bold text-white leading-tight">Build<br />Innovate<br />Evolve<br /><span class="text-primary">Together</span></div>
            <div class="w-8 h-8 rounded-full bg-primary/20 mx-auto mt-4 flex items-center justify-center">
              <i class="fa-solid fa-arrow-right text-primary text-xs"></i>
            </div>
          </div>
        </div>
        <!-- Floating Badge -->
        <div class="floating-badge">
          <div class="text-[10px] font-semibold mb-1" style="color:#6B7280">Technology Changing the Era,</div>
          <div class="text-xs font-bold" style="color:#111827">Let's Build with Synvora</div>
          <div class="w-8 h-0.5 bg-primary mt-2"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TRUSTED BY ================= -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-8">
      <h2 class="text-center text-sm font-bold text-gray-900 mb-10">Dipercaya oleh Organisasi di Berbagai Sektor</h2>
      <div class="flex flex-wrap justify-center md:justify-between items-center gap-8 opacity-60 grayscale hover:grayscale-0 transition duration-500">
        <div class="flex items-center gap-3 text-sm font-semibold text-gray-700">
          <i class="fa-solid fa-building-columns text-xl"></i> Pemerintahan
        </div>
        <div class="flex items-center gap-3 text-sm font-semibold text-gray-700">
          <i class="fa-solid fa-heart-pulse text-xl"></i> Kesehatan
        </div>
        <div class="flex items-center gap-3 text-sm font-semibold text-gray-700">
          <i class="fa-solid fa-graduation-cap text-xl"></i> Pendidikan
        </div>
        <div class="flex items-center gap-3 text-sm font-semibold text-gray-700">
          <i class="fa-solid fa-building text-xl"></i> Perusahaan
        </div>
        <div class="flex items-center gap-3 text-sm font-semibold text-gray-700">
          <i class="fa-solid fa-users text-xl"></i> Komunitas
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> LAYANAN KAMI
          </div>
          <h2 class="text-3xl font-extrabold text-gray-900 leading-tight">Solusi Digital untuk<br />Setiap Kebutuhan Anda</h2>
          <p class="text-sm text-gray-500 mt-4 max-w-xl">Kami menghadirkan layanan pengembangan sistem informasi yang disesuaikan dengan kebutuhan dan tujuan organisasi Anda.</p>
        </div>
        <a href="/layanan" class="text-primary text-sm font-semibold hover:underline flex items-center gap-2 mt-4 md:mt-0">
          Lihat Semua Layanan <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1 -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
            <i class="fa-solid fa-code"></i>
          </div>
          <h3 class="font-bold text-gray-900 mb-3">Pengembangan Sistem Informasi</h3>
          <p class="text-sm text-gray-500 mb-6 leading-relaxed">Custom software yang sesuai dengan proses bisnis Anda.</p>
          <a href="/layanan" class="text-primary text-xs font-semibold flex items-center gap-2">Pelajari Lebih Lanjut <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <!-- Card 2 -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
            <i class="fa-solid fa-cloud"></i>
          </div>
          <h3 class="font-bold text-gray-900 mb-3">Integrasi & Modernisasi Sistem</h3>
          <p class="text-sm text-gray-500 mb-6 leading-relaxed">Menghubungkan sistem lama dengan teknologi terbaru.</p>
          <a href="/layanan" class="text-primary text-xs font-semibold flex items-center gap-2">Pelajari Lebih Lanjut <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <!-- Card 3 -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
            <i class="fa-solid fa-mobile-screen"></i>
          </div>
          <h3 class="font-bold text-gray-900 mb-3">Aplikasi Web & Mobile</h3>
          <p class="text-sm text-gray-500 mb-6 leading-relaxed">Solusi lintas platform yang responsif dan user-friendly.</p>
          <a href="/layanan" class="text-primary text-xs font-semibold flex items-center gap-2">Pelajari Lebih Lanjut <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <!-- Card 4 -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 bg-blue-50 text-primary rounded-xl flex items-center justify-center text-xl mb-6">
            <i class="fa-solid fa-gear"></i>
          </div>
          <h3 class="font-bold text-gray-900 mb-3">Konsultasi IT</h3>
          <p class="text-sm text-gray-500 mb-6 leading-relaxed">Pendampingan strategis untuk transformasi digital Anda.</p>
          <a href="/layanan" class="text-primary text-xs font-semibold flex items-center gap-2">Pelajari Lebih Lanjut <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section class="py-24 bg-gray-50 px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div>
        <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> TENTANG SYNVORA
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900 leading-tight mb-6">Dari Semangat Kelompok,<br />Untuk Dampak yang Lebih Besar</h2>
        <p class="text-sm text-gray-500 leading-relaxed mb-8">
          SYNVORA Teknologi Indonesia lahir dari semangat sekelompok individu yang ingin membuat perubahan. Kami hadir sebagai perusahaan teknologi yang berfokus pada pengembangan sistem informasi, dengan misi menjadi top-of-mind ketika orang membutuhkan solusi digital.
        </p>

        <!-- Features -->
        <div class="flex flex-wrap gap-6 mb-10">
          <div class="flex items-center gap-3 text-sm font-semibold text-gray-800">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xs"><i class="fa-solid fa-bolt"></i></div>
            Inovatif
          </div>
          <div class="flex items-center gap-3 text-sm font-semibold text-gray-800">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xs"><i class="fa-solid fa-users"></i></div>
            Kolaboratif
          </div>
          <div class="flex items-center gap-3 text-sm font-semibold text-gray-800">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xs"><i class="fa-solid fa-shield-halved"></i></div>
            Berintegritas
          </div>
          <div class="flex items-center gap-3 text-sm font-semibold text-gray-800">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xs"><i class="fa-solid fa-heart"></i></div>
            Berdampak
          </div>
        </div>

        <a href="/tentang-kami" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold inline-flex items-center gap-2 transition">
          Kenali Kami Lebih Dekat <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <!-- Right Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <!-- Placeholder for Office Image -->
          <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=800" alt="SYNVORA Office" class="w-full h-[400px] object-cover">
        </div>
        <!-- Floating Badge -->
        <div class="absolute -bottom-6 -right-6 bg-white p-6 rounded-2xl shadow-xl max-w-[200px]">
          <div class="text-[10px] font-bold text-gray-900 mb-1">Synchronous</div>
          <div class="text-[10px] font-bold text-gray-900 mb-1">Innovation</div>
          <div class="text-[10px] font-bold text-gray-900 mb-1">Evolution</div>
          <div class="text-[10px] font-bold text-gray-900 mb-3">Era</div>
          <div class="w-6 h-0.5 bg-primary mb-3"></div>
          <div class="text-[9px] text-gray-500 leading-tight">Empowering progress through technology.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PORTFOLIO ================= -->
  <section class="py-24 bg-white px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> PORTOFOLIO
          </div>
          <h2 class="text-3xl font-extrabold text-gray-900 leading-tight">Karya Nyata, Dampak Nyata</h2>
          <p class="text-sm text-gray-500 mt-4 max-w-xl">Berbagai solusi digital yang telah kami kembangkan untuk membantu organisasi bekerja lebih efektif dan efisien.</p>
        </div>
        <a href="/portfolio" class="text-primary text-sm font-semibold hover:underline flex items-center gap-2 mt-4 md:mt-0">
          Lihat Semua Portofolio <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Portfolio 1 -->
        <div class="group cursor-pointer">
          <div class="rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/portfolio/labkesdasumenep[labkesdasumenep.id].png" alt="Pemerintahan" class="w-full h-48 object-cover object-top group-hover:scale-105 transition duration-500">
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800">Pemerintahan</div>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Website UPTD Labkesda Sumenep</h3>
          <p class="text-xs text-gray-500 mb-3">Website resmi laboratorium kesehatan daerah dengan pendaftaran online dan informasi layanan.</p>
          <a href="/portfolio" class="text-primary text-xs font-semibold flex items-center gap-2">Lihat Detail <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <!-- Portfolio 2 -->
        <div class="group cursor-pointer">
          <div class="rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/portfolio/produli[produli.labkesdasumenep.id].png" alt="Kesehatan" class="w-full h-48 object-cover object-top group-hover:scale-105 transition duration-500">
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800">Kesehatan</div>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Produli <span class="text-gray-400 font-normal">(Prolanis Peduli)</span></h3>
          <p class="text-xs text-gray-500 mb-3">Platform kesehatan preventif berbasis data laboratorium dengan analisis risiko otomatis.</p>
          <a href="/portfolio" class="text-primary text-xs font-semibold flex items-center gap-2">Lihat Detail <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <!-- Portfolio 3 -->
        <div class="group cursor-pointer">
          <div class="rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/portfolio/silacare[silacare.labkesdasumenep.id].png" alt="Aplikasi Mobile" class="w-full h-48 object-cover object-top group-hover:scale-105 transition duration-500">
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-gray-800">Aplikasi Mobile</div>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">SiLACARE</h3>
          <p class="text-xs text-gray-500 mb-3">Portal digital pasien untuk riwayat pemeriksaan lab dan antrean online.</p>
          <a href="/portfolio" class="text-primary text-xs font-semibold flex items-center gap-2">Lihat Detail <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= WORKFLOW ================= -->
  <section class="py-24 bg-white px-8 border-t border-gray-100">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16">
        <div>
          <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> PROSES KERJA
          </div>
          <h2 class="text-3xl font-extrabold text-gray-900 leading-tight">Langkah Terstruktur, Hasil Maksimal</h2>
        </div>
        <p class="text-sm text-gray-500 mt-4 md:mt-0 max-w-sm">Kami menerapkan proses pengembangan yang terstruktur dan transparan untuk memastikan setiap solusi memberikan nilai nyata.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
        <!-- Step 1 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm mb-6 z-10 relative">01</div>
          <h3 class="font-bold text-gray-900 mb-2">Analisis Kebutuhan</h3>
          <p class="text-xs text-gray-500">Memahami kebutuhan dan tujuan Anda.</p>
          <!-- Arrow -->
          <div class="hidden md:block absolute top-5 left-12 w-full h-0.5 bg-gray-200">
            <i class="fa-solid fa-chevron-right text-gray-300 absolute right-0 top-[-6px] text-xs"></i>
          </div>
        </div>
        <!-- Step 2 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm mb-6 z-10 relative">02</div>
          <h3 class="font-bold text-gray-900 mb-2">Perancangan Solusi</h3>
          <p class="text-xs text-gray-500">Merancang arsitektur dan desain sistem.</p>
          <div class="hidden md:block absolute top-5 left-12 w-full h-0.5 bg-gray-200">
            <i class="fa-solid fa-chevron-right text-gray-300 absolute right-0 top-[-6px] text-xs"></i>
          </div>
        </div>
        <!-- Step 3 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm mb-6 z-10 relative">03</div>
          <h3 class="font-bold text-gray-900 mb-2">Pengembangan</h3>
          <p class="text-xs text-gray-500">Membangun dengan standar kualitas tinggi.</p>
          <div class="hidden md:block absolute top-5 left-12 w-full h-0.5 bg-gray-200">
            <i class="fa-solid fa-chevron-right text-gray-300 absolute right-0 top-[-6px] text-xs"></i>
          </div>
        </div>
        <!-- Step 4 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm mb-6 z-10 relative">04</div>
          <h3 class="font-bold text-gray-900 mb-2">Implementasi & Dukungan</h3>
          <p class="text-xs text-gray-500">Peluncuran sistem dan dukungan berkelanjutan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TESTIMONIALS ================= -->
  <section class="py-24 bg-gray-50 px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <div class="text-xs font-bold text-primary tracking-widest mb-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> TESTIMONI
          </div>
          <h2 class="text-3xl font-extrabold text-gray-900 leading-tight">Apa Kata Mereka?</h2>
        </div>
        <p class="text-sm text-gray-500 mt-4 md:mt-0 max-w-sm">Kepercayaan klien adalah motivasi kami untuk terus berinovasi.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Testimonial 1 -->
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm relative">
          <i class="fa-solid fa-quote-left text-4xl text-blue-100 absolute top-6 left-6"></i>
          <p class="text-sm text-gray-600 leading-relaxed mb-8 relative z-10 pt-6">SYNVORA membantu kami membangun sistem yang benar-benar sesuai dengan kebutuhan. Profesional dan responsif!</p>
          <div class="flex items-center gap-4">
            <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=150" alt="dr. Andini Putri" class="w-12 h-12 rounded-full object-cover">
            <div>
