---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout
  title="Konsultasi Gratis - SYNVORA Teknologi Indonesia"
  description="Jadwalkan konsultasi gratis dengan tim ahli SYNVORA Teknologi Indonesia. Diskusikan kebutuhan sistem informasi Anda tanpa biaya dan tanpa komitmen."
  navVariant="light"
  footerVariant="default"
  active=""
  bodyClass="bg-[#F8FAFC] dark:bg-synvora-dark"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <style is:global>
      .hero-bg {
        background-color: #0a1128;
        /* Placeholder image: Menyesuaikan dengan gambar tim berkolaborasi */
        background-image: linear-gradient(to right, rgba(10, 17, 40, 0.95) 0%, rgba(10, 17, 40, 0.85) 40%, rgba(10, 17, 40, 0.4) 100%),
          url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .form-input {
        width: 100%;
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 12px;
        color: #374151;
        transition: all 0.2s ease;
      }
      .form-input:focus {
        outline: none;
        border-color: #0066ff;
        box-shadow: 0 0 0 3px rgba(0, 102, 255, 0.1);
      }
      .form-input::placeholder {
        color: #9ca3af;
      }
      .cta-bg {
        background-color: #0a1128;
        background-image: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.85)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80&w=1600');
        background-size: cover;
        background-position: center;
      }
      .workflow-arrow {
        position: absolute;
        top: 20px;
        right: -10px;
        color: #9ca3af;
        font-size: 14px;
        z-index: 1;
        background: #f8fafc;
        padding: 0 4px;
      }
      .dark .form-input {
        background-color: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.12);
        color: #e5e7eb;
      }
      .dark .form-input::placeholder {
        color: #6b7280;
      }
      .dark .workflow-arrow {
        background: #0a1128;
      }

      /* Flatpickr theming - matches SYNVORA form-input styling */
      .flatpickr-calendar {
        font-family: 'Plus Jakarta Sans', sans-serif;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(10, 17, 40, 0.12);
        border: 1px solid #e5e7eb;
      }
      .flatpickr-day.selected,
      .flatpickr-day.selected:hover,
      .flatpickr-day.selected:focus {
        background: #0066ff;
        border-color: #0066ff;
      }
      .flatpickr-day.today {
        border-color: #0066ff;
      }
      .flatpickr-day:hover {
        background: #eff6ff;
      }
      .flatpickr-months .flatpickr-month,
      .flatpickr-current-month .flatpickr-monthDropdown-months,
      .flatpickr-weekdays,
      span.flatpickr-weekday {
        color: #0a1128;
      }
      .flatpickr-time input:hover,
      .flatpickr-time .flatpickr-am-pm:hover {
        background: #eff6ff;
      }
      .dark .flatpickr-calendar {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        color: #e5e7eb;
      }
      .dark .flatpickr-day {
        color: #e5e7eb;
      }
      .dark .flatpickr-day.flatpickr-disabled,
      .dark .flatpickr-day.prevMonthDay,
      .dark .flatpickr-day.nextMonthDay {
        color: rgba(255, 255, 255, 0.25);
      }
      .dark .flatpickr-day:hover {
        background: rgba(0, 102, 255, 0.15);
      }
      .dark .flatpickr-months .flatpickr-month,
      .dark .flatpickr-weekdays,
      .dark span.flatpickr-weekday,
      .dark .flatpickr-current-month input.cur-year,
      .dark .flatpickr-current-month .flatpickr-monthDropdown-months {
        background: transparent;
        color: #e5e7eb;
      }
      .dark .flatpickr-months .flatpickr-prev-month svg,
      .dark .flatpickr-months .flatpickr-next-month svg {
        fill: #e5e7eb;
      }
      .dark .flatpickr-time {
        background: #0f1a3d;
        border-color: rgba(255, 255, 255, 0.12);
      }
      .dark .flatpickr-time input {
        color: #e5e7eb;
        background: transparent;
      }
      .dark .numInputWrapper span.arrowUp:after {
        border-bottom-color: #e5e7eb;
      }
      .dark .numInputWrapper span.arrowDown:after {
        border-top-color: #e5e7eb;
      }
    </style>
  </Fragment>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-bg text-white pt-20 pb-32 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div>
        <!-- Breadcrumb -->
        <div class="text-xs font-semibold text-gray-400 mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-white cursor-pointer">Beranda</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-white">Konsultasi Gratis</span>
        </div>

        <!-- Title -->
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
          Konsultasi <span class="text-primary">Gratis</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-gray-300 text-sm md:text-base mb-10 max-w-lg leading-relaxed">
          Diskusikan kebutuhan teknologi Anda dengan tim ahli kami, tanpa biaya dan tanpa komitmen.
        </p>

        <!-- Tagline -->
        <div class="border-l-4 border-primary pl-4">
          <div class="text-xs font-bold tracking-[0.2em] text-white mb-2">
            SYNCHRONOUS &bull; INNOVATION &bull; EVOLUTION &bull; ERA
          </div>
          <div class="text-xs text-gray-400">
            A Better Tomorrow Through Technology
          </div>
        </div>
      </div>

      <!-- Right Text Overlay -->
      <div class="hidden lg:flex justify-end relative">
        <div class="text-right">
          <div class="text-4xl font-extrabold text-white leading-tight mb-2">
            Great<br>People<br>Build<br>Great<br>Solutions
          </div>
          <div class="w-12 h-1 bg-primary ml-auto"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURE HIGHLIGHTS ================= -->
  <section class="py-16 bg-white px-8 border-b border-gray-100">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Highlight 1 -->
      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-comments"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">Diskusi Langsung dengan Ahli</h3>
      </div>
      <!-- Highlight 2 -->
      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
          <i class="fa-regular fa-lightbulb"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">Rekomendasi Solusi Sesuai Kebutuhan</h3>
      </div>
      <!-- Highlight 3 -->
      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-file-invoice"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">Tanpa Biaya dan Tanpa Komitmen</h3>
      </div>
      <!-- Highlight 4 -->
      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <div class="w-12 h-12 bg-blue-50 text-primary rounded-full flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-rocket"></i>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">Langkah Awal Menuju Transformasi</h3>
      </div>
    </div>
  </section>

  <!-- ================= MAIN CONTENT (FORM & SIDEBAR) ================= -->
  <section class="py-24 px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- LEFT COLUMN: CONSULTATION FORM -->
      <div class="lg:col-span-2">
        <div class="bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-gray-100">
          <!-- Shown instead of the form once this visitor has already used their free consultation -->
          <div id="consultation-quota-used" class="hidden text-center py-6">
            <div class="w-16 h-16 rounded-full bg-blue-50 text-primary flex items-center justify-center text-2xl mx-auto mb-6">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <h2 class="text-xl font-extrabold text-gray-900 mb-3">Anda Sudah Mengajukan Konsultasi Gratis</h2>
            <p class="text-sm text-gray-500 max-w-md mx-auto mb-2 leading-relaxed">
              Untuk menjaga kualitas layanan, setiap pengguna hanya dapat mengajukan konsultasi gratis satu kali.
            </p>
            <p class="text-sm text-gray-500 max-w-md mx-auto mb-8 leading-relaxed">
              Jika Anda serius ingin membangun kerja sama dengan kami, jangan ragu untuk menghubungi kami langsung - tim kami akan dengan senang hati membantu.
            </p>
            <a href="/hubungi-kami" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold inline-flex items-center gap-2 transition">
              Hubungi Kami <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>

          <div id="consultation-form-wrapper">
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Jadwalkan Konsultasi Gratis</h2>
          <p class="text-xs text-gray-500 mb-8">Isi formulir berikut dan pilih waktu yang sesuai. Tim kami akan mengonfirmasi jadwal melalui email atau WhatsApp.</p>

          <form id="consultation-form" class="space-y-6">
            <!-- Honeypot - hidden from real visitors, catches basic bots -->
            <input type="text" name="company_website" class="hidden" tabindex="-1" autocomplete="off">

            <!-- Row 1 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-2">Nama Lengkap <span class="text-red-500">*</span></label>
                <input type="text" name="name" required placeholder="Masukkan nama lengkap Anda" class="form-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-2">Email <span class="text-red-500">*</span></label>
                <input type="email" name="email" required placeholder="nama@perusahaan.com" class="form-input">
              </div>
            </div>

            <!-- Row 2 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-2">Nomor WhatsApp <span class="text-red-500">*</span></label>
                <input type="tel" name="whatsapp" required placeholder="Contoh: 0811 234 567" class="form-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-2">Nama Perusahaan / Instansi</label>
                <input type="text" name="company" placeholder="Masukkan nama perusahaan" class="form-input">
              </div>
            </div>

            <!-- Row 3 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-2">Jenis Kebutuhan <span class="text-red-500">*</span></label>
                <div class="relative">
                  <select name="needType" required class="form-input appearance-none cursor-pointer">
                    <option value="" disabled selected>Pilih jenis kebutuhan</option>
                    <option>Pengembangan Sistem Informasi</option>
                    <option>Integrasi & Modernisasi Sistem</option>
                    <option>Aplikasi Web & Mobile</option>
                    <option>Konsultasi IT</option>
                    <option>Lainnya</option>
                  </select>
                  <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
                </div>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-2">Pilih Tanggal Konsultasi <span class="text-red-500">*</span></label>
                <div class="relative">
                  <input type="text" id="consultation-date" name="date" required readonly placeholder="Pilih tanggal" class="form-input cursor-pointer">
                  <i class="fa-regular fa-calendar absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
                </div>
              </div>
            </div>

            <!-- Row 4 -->
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-2">Pilih Waktu <span class="text-red-500">*</span></label>
              <div class="relative">
                <input type="text" id="consultation-time" name="time" required readonly placeholder="Pilih waktu (09.00 - 16.00 WIB)" class="form-input cursor-pointer">
                <i class="fa-regular fa-clock absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
              </div>
            </div>

            <!-- Row 5 -->
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-2">Ceritakan Kebutuhan Anda <span class="text-red-500">*</span></label>
              <textarea rows="5" name="details" required placeholder="Jelaskan secara singkat kebutuhan atau tantangan yang ingin Anda diskusikan..." class="form-input resize-none"></textarea>
            </div>

            {turnstileSiteKey && (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="konsultasi-gratis" data-theme="light"></div>
            )}

            <!-- Status message -->
            <div id="consultation-form-status" class="hidden text-xs font-semibold rounded-lg px-4 py-3"></div>

            <!-- Submit Button -->
            <div>
              <button type="submit" class="w-full btn-primary py-3.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2">
                <span class="submit-label">Ajukan Konsultasi Gratis</span> <i class="fa-solid fa-arrow-right text-xs submit-icon"></i>
              </button>
            </div>

            <!-- Privacy Note -->
            <div class="flex items-center justify-center gap-2 text-[10px] text-gray-400 mt-4">
              <i class="fa-solid fa-lock"></i> Data Anda aman dan hanya digunakan untuk keperluan konsultasi.
            </div>
          </form>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: SIDEBAR -->
      <div class="lg:col-span-1 space-y-8">

        <!-- What You Will Get Card -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <h3 class="font-bold text-gray-900 text-base mb-6">Apa yang Akan Anda Dapatkan?</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-primary mt-0.5 text-sm"></i>
              <span class="text-xs text-gray-600">Diskusi langsung dengan tim ahli</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-primary mt-0.5 text-sm"></i>
              <span class="text-xs text-gray-600">Analisis kebutuhan awal</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-primary mt-0.5 text-sm"></i>
              <span class="text-xs text-gray-600">Rekomendasi solusi yang relevan</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-primary mt-0.5 text-sm"></i>
              <span class="text-xs text-gray-600">Estimasi ruang lingkup dan waktu</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-primary mt-0.5 text-sm"></i>
              <span class="text-xs text-gray-600">Tanpa biaya dan tanpa komitmen</span>
            </li>
          </ul>
        </div>

        <!-- Testimonial Card -->
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 relative">
          <i class="fa-solid fa-quote-left text-4xl text-blue-100 absolute top-6 left-6"></i>
          <p class="text-xs text-gray-600 italic relative z-10 mb-6 pl-4 pt-6">"Konsultasi dengan tim SYNVORA sangat membantu kami memahami kebutuhan sistem yang tepat. Penjelasannya jelas dan profesional."</p>
          <div class="flex items-center gap-3 border-t border-gray-200 pt-4 pl-4">
            <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=150" alt="dr. Andi Pratama" class="w-10 h-10 rounded-full object-cover">
            <div>
              <div class="font-bold text-xs text-gray-900">dr. Andi Pratama</div>
              <div class="text-[10px] text-gray-500">Kepala Instansi Kesehatan</div>
            </div>
          </div>
        </div>

        <!-- Contact/Help Card -->
        <div class="bg-[#0A1128] p-8 rounded-2xl shadow-lg relative overflow-hidden">
          <!-- Background Glow -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary rounded-full filter blur-[50px] opacity-30"></div>

          <div class="relative z-10">
            <div class="text-xs font-bold text-primary tracking-widest mb-2">PUNYA PERTANYAAN?</div>
            <h3 class="font-bold text-white text-base mb-6">Tim kami siap membantu kapan saja.</h3>

            <ul class="space-y-4">
              <li class="flex items-center gap-3 text-xs text-gray-300">
                <i class="fa-brands fa-whatsapp text-primary w-4"></i>
                <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition">{SITE.phoneDisplay}</a>
              </li>
              <li class="flex items-center gap-3 text-xs text-gray-300">
                <i class="fa-regular fa-envelope text-primary w-4"></i>
                <span>{SITE.email}</span>
              </li>
              <li class="flex items-start gap-3 text-xs text-gray-300">
                <i class="fa-regular fa-clock text-primary w-4 mt-0.5"></i>
                <span>Senin - Jumat<br>08.00 - 17.00 WIB</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= WORKFLOW SECTION ================= -->
  <section class="py-16 bg-white px-8 border-t border-gray-100">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="mb-12">
        <h2 class="text-2xl font-extrabold text-gray-900 leading-tight mb-2">Bagaimana Prosesnya?</h2>
        <p class="text-sm text-gray-500">Hanya beberapa langkah untuk memulai konsultasi.</p>
      </div>

      <!-- Steps -->
      <div class="relative">
        <!-- Connecting Line -->
        <div class="hidden md:block absolute top-6 left-0 right-0 h-0.5 bg-gray-200 z-0"></div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative z-10">
          <!-- Step 1 -->
          <div class="relative text-center md:text-left">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center text-sm font-bold mx-auto md:mx-0 mb-6 border-4 border-white shadow-sm relative z-10">
              01
            </div>
            <h3 class="font-bold text-gray-900 text-sm mb-2">Isi Formulir</h3>
            <p class="text-[11px] text-gray-500 leading-relaxed">Lengkapi data dan kebutuhan Anda.</p>
            <!-- Arrow -->
            <div class="hidden md:flex absolute top-5 -right-4 text-gray-300 z-20">
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </div>
          </div>
          <!-- Step 2 -->
          <div class="relative text-center md:text-left">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center text-sm font-bold mx-auto md:mx-0 mb-6 border-4 border-white shadow-sm relative z-10">
              02
            </div>
            <h3 class="font-bold text-gray-900 text-sm mb-2">Konfirmasi Jadwal</h3>
            <p class="text-[11px] text-gray-500 leading-relaxed">Tim kami akan menghubungi untuk konfirmasi.</p>
            <div class="hidden md:flex absolute top-5 -right-4 text-gray-300 z-20">
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </div>
          </div>
          <!-- Step 3 -->
          <div class="relative text-center md:text-left">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center text-sm font-bold mx-auto md:mx-0 mb-6 border-4 border-white shadow-sm relative z-10">
              03
            </div>
            <h3 class="font-bold text-gray-900 text-sm mb-2">Sesi Konsultasi</h3>
            <p class="text-[11px] text-gray-500 leading-relaxed">Diskusi langsung dengan tim ahli kami.</p>
            <div class="hidden md:flex absolute top-5 -right-4 text-gray-300 z-20">
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </div>
          </div>
          <!-- Step 4 -->
          <div class="relative text-center md:text-left">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center text-sm font-bold mx-auto md:mx-0 mb-6 border-4 border-white shadow-sm relative z-10">
              04
            </div>
            <h3 class="font-bold text-gray-900 text-sm mb-2">Dapatkan Rekomendasi</h3>
            <p class="text-[11px] text-gray-500 leading-relaxed">Terima insight dan solusi terbaik untuk Anda.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BOTTOM CTA ================= -->
  <section class="py-16 px-8 bg-white">
    <div class="max-w-7xl mx-auto cta-bg rounded-3xl p-12 flex flex-col md:flex-row justify-between items-center relative overflow-hidden shadow-2xl">
      <!-- Background glow -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary rounded-full filter blur-[100px] opacity-20"></div>

      <div class="z-10 mb-8 md:mb-0 max-w-2xl">
        <div class="text-xs font-bold text-primary tracking-widest mb-2">SIAP BERKOLABORASI?</div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-tight mb-4">
          Wujudkan Solusi Teknologi<br>untuk Masa Depan yang Lebih Baik.
        </h2>
      </div>

      <div class="flex gap-4 z-10">
        <a href="#consultation-form" class="bg-primary hover:bg-blue-700 text-white px-8 py-3.5 rounded-full text-sm font-semibold flex items-center gap-2 transition">
          Konsultasi Gratis <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>

  <script>
    declare global {
      interface Window {
        turnstile?: { reset: (widget?: string | HTMLElement) => void };
      }
    }

    // Business-hour consultation slots (Mon-Fri, with a lunch break 11.00-13.00).
    const SLOTS = [
      { start: '09:00', end: '10:00' },
      { start: '10:00', end: '11:00' },
      { start: '13:00', end: '14:00' },
      { start: '14:00', end: '15:00' },
      { start: '15:00', end: '16:00' },
    ];
    const VALID_HOURS = SLOTS.map((s) => Number(s.start.split(':')[0]));

    function initFlatpickr() {
      const fp = (window as any).flatpickr;
      if (!fp) return;

      const dateInput = document.getElementById('consultation-date');
      if (dateInput) {
        fp(dateInput, {
          dateFormat: 'Y-m-d',
          altInput: true,
          altFormat: 'l, d F Y',
          minDate: 'today',
          locale: { firstDayOfWeek: 1 },
          disable: [(date: Date) => date.getDay() === 0 || date.getDay() === 6], // weekends off
        });
      }

      const timeInput = document.getElementById('consultation-time');
      if (timeInput) {
        fp(timeInput, {
          noCalendar: true,
          enableTime: true,
          time_24hr: true,
          dateFormat: 'H:i',
          minTime: '09:00',
          maxTime: '15:00',
          minuteIncrement: 60,
          onChange: (selectedDates: Date[], _dateStr: string, instance: any) => {
            if (!selectedDates.length) return;
            let hour = selectedDates[0].getHours();

            // Skip the 11.00-13.00 lunch break by snapping forward to the next open slot.
            if (!VALID_HOURS.includes(hour)) {
              hour = VALID_HOURS.find((h) => h > hour) ?? VALID_HOURS[0];
              const snapped = new Date(selectedDates[0]);
              snapped.setHours(hour, 0, 0, 0);
              instance.setDate(snapped, false);
            }

            const slot = SLOTS.find((s) => Number(s.start.split(':')[0]) === hour) ?? SLOTS[0];
            const label = `${slot.start} - ${slot.end} WIB`;
            instance.input.value = label;
            if (instance.altInput) instance.altInput.value = label;
          },
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFlatpickr);
    } else {
      initFlatpickr();
    }

    const form = document.getElementById('consultation-form') as HTMLFormElement | null;
    const statusBox = document.getElementById('consultation-form-status');
    const formWrapper = document.getElementById('consultation-form-wrapper');
    const quotaUsedPanel = document.getElementById('consultation-quota-used');

    function showQuotaUsed() {
      formWrapper?.classList.add('hidden');
      quotaUsedPanel?.classList.remove('hidden');
    }

    // Proactively check on page load so a repeat visitor sees the friendly
    // "quota used" message right away instead of filling the whole form
    // only to be turned away at submit time.
    fetch('/api/consultation-status')
      .then((res) => res.json())
      .then((data) => {
        if (data.limited) showQuotaUsed();
      })
      .catch(() => {
        /* if the check itself fails, let them try submitting normally -
           the server enforces the limit either way */
      });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const label = button.querySelector('.submit-label');
      const icon = button.querySelector('.submit-icon');

      button.disabled = true;
      if (label) label.textContent = 'Mengirim...';
      icon?.classList.replace('fa-arrow-right', 'fa-spinner');
      icon?.classList.add('fa-spin');
      statusBox?.classList.add('hidden');

      try {
        const res = await fetch('/api/consultation', { method: 'POST', body: new FormData(form) });
        const data = await res.json();

        if (statusBox) {
          statusBox.classList.remove('hidden');
          if (data.ok) {
            statusBox.className = 'text-xs font-semibold rounded-lg px-4 py-3 bg-green-50 text-green-700 border border-green-200';
            statusBox.textContent = 'Permintaan konsultasi Anda berhasil terkirim. Tim kami akan segera mengonfirmasi jadwal.';
            form.reset();
            window.turnstile?.reset();
          } else if (data.limited) {
            showQuotaUsed();
          } else {
            statusBox.className = 'text-xs font-semibold rounded-lg px-4 py-3 bg-red-50 text-red-700 border border-red-200';
            statusBox.textContent = data.error || 'Terjadi kesalahan. Silakan coba lagi.';
            window.turnstile?.reset();
          }
        }
      } catch {
        if (statusBox) {
          statusBox.classList.remove('hidden');
          statusBox.className = 'text-xs font-semibold rounded-lg px-4 py-3 bg-red-50 text-red-700 border border-red-200';
          statusBox.textContent = 'Gagal terhubung ke server. Periksa koneksi Anda dan coba lagi.';
        }
        window.turnstile?.reset();
      } finally {
        button.disabled = false;
        if (label) label.textContent = 'Ajukan Konsultasi Gratis';
        icon?.classList.replace('fa-spinner', 'fa-arrow-right');
        icon?.classList.remove('fa-spin');
      }
    });
  </script>
</Layout>
